{%- doc -%}
  Line icons for the fit pages (stroke = currentColor).
  @param {string} name - bra | tape | chat | phone | email | whatsapp | ruler | heart
  @param {number} [size] - Width and height in px (default 34)
{%- enddoc -%}
{%- assign s = size | default: 34 -%}
<svg class="bls-fit-icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case name -%}
    {%- when 'bra' -%}
      <path d="M9 6v7.5M23 6v7.5"/><path d="M4 21c0-4.4 2.7-7.8 6-7.8s6 3.4 6 7.8c0-4.4 2.7-7.8 6-7.8s6 3.4 6 7.8"/><path d="M4 21h24M4 21v3h24v-3"/>
    {%- when 'tape' -%}
      <circle cx="12" cy="13" r="8"/><circle cx="12" cy="13" r="2.4"/><path d="M12 21h16v5H12M16 21v2.5M20 21v2.5M24 21v2.5"/>
    {%- when 'chat' -%}
      <path d="M5 7h22v14H14l-6 5v-5H5z"/><path d="M10 12.5h12M10 16h8"/>
    {%- when 'phone' -%}
      <path d="M8.5 4.5 12 5l2 5.5-2.5 2a14 14 0 0 0 8 8l2-2.5 5.5 2 .5 3.5c0 1.4-1.1 2.5-2.5 2.5C13.6 26 6 18.4 6 7c0-1.4 1.1-2.5 2.5-2.5z"/>
    {%- when 'email' -%}
      <rect x="4" y="7.5" width="24" height="17" rx="1.5"/><path d="m4.5 8.5 11.5 9 11.5-9"/>
    {%- when 'whatsapp' -%}
      <path d="M6.2 25.8 7.6 21A11 11 0 1 1 11 24.4z"/><path d="M12.4 10.6c.3-.6.9-.6 1.2 0l1 2.2c.1.3 0 .6-.2.8l-.8.8a8 8 0 0 0 3.9 3.9l.8-.8c.2-.2.5-.3.8-.2l2.2 1c.6.3.6.9 0 1.2-1 .9-2.4 1.2-3.7.7a11.5 11.5 0 0 1-6-6c-.5-1.3-.2-2.7.7-3.7z"/>
    {%- when 'ruler' -%}
      <rect x="3" y="11" width="26" height="10" rx="1"/><path d="M7 11v4M11 11v6M15 11v4M19 11v6M23 11v4"/>
    {%- else -%}
      <path d="M16 26s-10-6.2-10-13a5.5 5.5 0 0 1 10-3.2A5.5 5.5 0 0 1 26 13c0 6.8-10 13-10 13z"/>
  {%- endcase -%}
</svg>
