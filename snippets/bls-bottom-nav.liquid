{%- doc -%}
  App-style bottom bar on phones: Menu (opens the menu), Search (opens the search), Home in the
  centre, Wishlist (with its count) and Bag (opens the cart drawer, with the item count). It presses the header's own
  buttons, so the menu, search and cart work exactly as before; on phones those header buttons are
  kept in place but not shown, leaving the logo alone in the top bar. Hidden from 750px up.
{%- enddoc -%}
{%- liquid
  assign t = template.name
  assign wl_url = '/pages/wish-list'
-%}
<nav class="bls-bnav" aria-label="Shortcuts" data-bls-bnav>
  <button type="button" class="bls-bnav__item" data-bls-bnav-open="menu">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M4.5 7h15"/><path d="M4.5 12h15"/><path d="M4.5 17h15"/></svg>
    <span>Menu</span>
  </button>
  <button type="button" class="bls-bnav__item{% if t == 'search' %} is-active{% endif %}" data-bls-bnav-open="search">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3"/></svg>
    <span>Search</span>
  </button>
  <a class="bls-bnav__item{% if t == 'index' %} is-active{% endif %}" href="{{ routes.root_url }}"{% if t == 'index' %} aria-current="page"{% endif %}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.6 12 4l8 6.6V19a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19z"/><path d="M9.5 20.5V14.5h5v6"/></svg>
    <span>Home</span>
  </a>
  <a class="bls-bnav__item{% if request.path contains 'wish' %} is-active{% endif %}" href="{{ wl_url }}"{% if request.path contains 'wish' %} aria-current="page"{% endif %}>
    <span class="bls-bnav__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.3s-8-4.7-8-10.6A4.4 4.4 0 0 1 12 7.2a4.4 4.4 0 0 1 8 2.5c0 5.9-8 10.6-8 10.6z"/></svg>
      <span class="bls-bnav__badge" data-wac-wishlist-count hidden></span>
    </span>
    <span>Wishlist</span>
  </a>
  <button type="button" class="bls-bnav__item{% if t == 'cart' %} is-active{% endif %}" data-bls-bnav-open="cart">
    <span class="bls-bnav__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8.5h12l1 11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 19.5z"/><path d="M9 11V7a3 3 0 0 1 6 0v4"/></svg>
      <span class="bls-bnav__badge" data-bls-bnav-cart{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </span>
    <span>Bag</span>
  </button>
</nav>
<script>
  (function () {
    if (window.blsBottomNav) return;
    window.blsBottomNav = true;
    var targets = {
      menu: ['.header-section .header__icon--menu', '/collections/all'],
      search: ['.header-section search-button button, .header-section .search-action button', '/search'],
      cart: ['.header-section cart-drawer-component button.header-actions__action', '/cart']
    };
    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-bls-bnav-open]');
      if (!b) return;
      var t = targets[b.getAttribute('data-bls-bnav-open')];
      var el = t && document.querySelector(t[0]);
      if (el) el.click(); else if (t) window.location.href = t[1];
    });
    function setCount(n) {
      document.querySelectorAll('[data-bls-bnav-cart]').forEach(function (el) {
        el.textContent = n > 0 ? String(n) : '';
        el.hidden = !(n > 0);
      });
    }
    document.addEventListener('cart:update', function (e) {
      var d = e.detail || {};
      var n = d.data && typeof d.data.itemCount === 'number' ? d.data.itemCount : (d.resource && typeof d.resource.item_count === 'number' ? d.resource.item_count : null);
      if (n !== null) { setCount(n); return; }
      fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (c) { setCount(c.item_count); }).catch(function () {});
    });
  })();
</script>
