{{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
{%- comment -%} Wacoal replica: extra weights of the store body font (Poppins) and heading font, Bebas Neue from Google Fonts for the condensed capitals, then the replica stylesheet. {%- endcomment -%}
{%- liquid
  assign wac_body = settings.type_body_font
  assign wac_body_400 = wac_body | font_modify: 'weight', '400'
  assign wac_body_500 = wac_body | font_modify: 'weight', '500'
  assign wac_body_600 = wac_body | font_modify: 'weight', '600'
  assign wac_body_700 = wac_body | font_modify: 'weight', '700'
  assign wac_serif_400 = settings.type_heading_font | font_modify: 'weight', '400'
  assign wac_serif_400i = wac_serif_400 | font_modify: 'style', 'italic'
  assign wac_serif_600 = settings.type_heading_font | font_modify: 'weight', '600'
  assign wac_serif_500 = settings.type_heading_font | font_modify: 'weight', '500'
  assign wac_serif_500i = wac_serif_500 | font_modify: 'style', 'italic'
-%}
<style>
  {% if wac_body_400 %}{{ wac_body_400 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_body_500 %}{{ wac_body_500 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_body_600 %}{{ wac_body_600 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_body_700 %}{{ wac_body_700 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_serif_400 %}{{ wac_serif_400 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_serif_400i %}{{ wac_serif_400i | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_serif_600 %}{{ wac_serif_600 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_serif_500 %}{{ wac_serif_500 | font_face: font_display: 'swap' }}{% endif %}
  {% if wac_serif_500i %}{{ wac_serif_500i | font_face: font_display: 'swap' }}{% endif %}
  /* Font roles: Horizon's small headings use Bebas Neue, its headings and italic accent Achemost (store fonts until the Achemost file is in assets). html:root beats the theme's later :root variables. */
  html:root {
    --font-subheading--family: 'Bebas Neue', 'Arial Narrow', sans-serif;
    --font-heading--family: 'Achemost', {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-accent--family: 'Achemost', {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
  }
</style>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap">
{{ 'wacoal.css' | asset_url | stylesheet_tag }}
