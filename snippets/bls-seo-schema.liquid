{%- comment -%}
  Structured data for search and AI answers: the brand on every page, site search on the home page,
  breadcrumbs on collection and product pages. Product data itself is in bls-main-product,
  store addresses in bls-store-locator.
{%- endcomment -%}
{%- liquid
  assign site = request.origin
  assign org_id = site | append: '/#organization'
  assign logo_url = ''
  if settings.logo != blank
    assign logo_url = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ org_id | json }},
    "name": "British Lingerie Studio",
    "alternateName": ["BLS", {{ shop.name | json }}],
    "url": {{ site | append: '/' | json }},
    {%- if logo_url != blank %}
    "logo": {{ logo_url | json }},
    {%- endif %}
    "areaServed": { "@type": "Country", "name": "Pakistan" }
    {%- if settings.seo_instagram != blank or settings.seo_facebook != blank -%},
    "sameAs": [
      {%- if settings.seo_instagram != blank -%}{{ settings.seo_instagram | json }}{%- endif -%}
      {%- if settings.seo_instagram != blank and settings.seo_facebook != blank -%},{%- endif -%}
      {%- if settings.seo_facebook != blank -%}{{ settings.seo_facebook | json }}{%- endif -%}
    ]
    {%- endif %}
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ site | append: '/#website' | json }},
      "name": "British Lingerie Studio",
      "alternateName": "BLS",
      "url": {{ site | append: '/' | json }},
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ site | append: routes.search_url | append: '?q={search_term_string}' | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- liquid
  assign crumb = blank
  if request.page_type == 'product'
    for c in product.collections
      assign c_head = c.handle | slice: 0, 5
      if c.handle != 'all' and c.handle != 'frontpage' and c_head != 'avada'
        assign crumb = c
        break
      endif
    endfor
  endif
-%}
{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ site | append: collection.url | json }} }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site | append: '/' | json }} },
        {%- if crumb != blank %}
        { "@type": "ListItem", "position": 2, "name": {{ crumb.title | json }}, "item": {{ site | append: crumb.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ site | append: product.url | json }} }
        {%- else %}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ site | append: product.url | json }} }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}
