{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # BLS search set-up: on for everyone once the "Search and sharing" switch is on, on ?view=t pages for testing
  assign seo_v2 = false
  if settings.bls_seo_live or template.suffix == 't'
    assign seo_v2 = true
  endif
  assign seo_description = page_description
  assign share_image = page_image
  if seo_v2
    # Products and collections without their own search description get one built from their facts,
    # instead of Shopify's cut-off first 320 characters of the description
    assign built = ''
    assign desc_end = settings.seo_desc_end | strip
    if request.page_type == 'product' and product.metafields.global.description_tag == blank
      assign p_name = product.title | remove_first: 'BLS - ' | strip
      assign size_opt = product.options_with_values | where: 'name', 'Size' | first
      capture built
        echo p_name
        echo ' by British Lingerie Studio. '
        if size_opt != blank and size_opt.values.size > 1
          echo 'Sizes ' | append: size_opt.values.first | append: ' to ' | append: size_opt.values.last | append: ', '
        endif
        echo product.price | money_without_trailing_zeros | strip_html
        echo '. '
        echo desc_end
      endcapture
    elsif request.page_type == 'collection' and collection != blank and collection.metafields.global.description_tag == blank
      # The collection's own intro (first paragraph) when it has one, else a line built from its facts
      assign intro = collection.description | split: '</p>' | first | strip_html | strip
      if intro != blank and intro.size <= 170
        assign built = intro
      else
        capture built
          echo 'Shop ' | append: collection.title | append: ' from British Lingerie Studio: '
          echo collection.products_count | append: ' styles online. '
          echo desc_end
        endcapture
      endif
    endif
    if built != blank
      assign seo_description = built | strip
    else
      assign seo_description = seo_description | truncate: 160
    endif
    assign seo_description = seo_description | strip_html | strip_newlines | strip
    assign og_description = seo_description | default: shop.description | default: shop.name | truncate: 200

    # Pages without a photo of their own still get one when shared (WhatsApp, Facebook)
    if share_image == blank
      if request.page_type == 'collection' and collection.products.first.featured_image != blank
        assign share_image = collection.products.first.featured_image
      elsif settings.seo_share_image != blank
        assign share_image = settings.seo_share_image
      endif
    endif
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{% if seo_v2 %}{{ og_description | escape_once }}{% else %}{{ og_description | escape }}{% endif %}"
>

{%- if seo_v2 and share_image != blank -%}
  {%- liquid
    assign share_w = share_image.width | at_most: 1200
    assign share_h = share_w | divided_by: share_image.aspect_ratio | round
  -%}
  <meta
    property="og:image"
    content="http:{{ share_image | image_url: width: share_w, format: 'jpg' }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_image | image_url: width: share_w, format: 'jpg' }}"
  >
  <meta
    property="og:image:width"
    content="{{ share_w }}"
  >
  <meta
    property="og:image:height"
    content="{{ share_h }}"
  >
{%- elsif page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{% if seo_v2 %}{{ og_description | escape_once }}{% else %}{{ og_description | escape }}{% endif %}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- if seo_v2 -%}
    {%- unless page_title contains 'British Lingerie Studio' %} &ndash; {{ shop.name }}{% endunless -%}
  {%- else -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if seo_v2 and settings.seo_noindex != blank -%}
  {%- liquid
    # Duplicate or leftover pages and catalogue-copy collections listed in the theme settings stay out of Google
    assign noindex_list = settings.seo_noindex | remove: ' ' | downcase | prepend: ',' | append: ','
    assign this_handle = ''
    if request.page_type == 'collection' and collection != blank
      assign this_handle = collection.handle
    elsif request.page_type == 'page'
      assign this_handle = page.handle
    endif
    assign handle_key = ',' | append: this_handle | append: ','
  -%}
  {%- if this_handle != blank and noindex_list contains handle_key -%}
    <meta
      name="robots"
      content="noindex, follow"
    >
  {%- endif -%}
{%- endif -%}

{% if seo_v2 %}
  {%- if seo_description != blank -%}
    <meta
      name="description"
      content="{{ seo_description | escape_once }}"
    >
  {%- endif -%}
  {%- comment -%} Structured data for search and AI answers: brand on every page, site search on home, breadcrumbs on collections and products (product and store data are in their sections) {%- endcomment -%}
{%- liquid
  assign site = request.origin
  assign org_id = site | append: '/#organization'
  assign logo_url = ''
  if settings.logo != blank
    assign logo_url = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ org_id | json }},
    "name": "British Lingerie Studio",
    "alternateName": ["BLS", {{ shop.name | json }}],
    "url": {{ site | append: '/' | json }},
    {%- if logo_url != blank %}
    "logo": {{ logo_url | json }},
    {%- endif %}
    "areaServed": { "@type": "Country", "name": "Pakistan" }
    {%- if settings.seo_instagram != blank or settings.seo_facebook != blank -%},
    "sameAs": [
      {%- if settings.seo_instagram != blank -%}{{ settings.seo_instagram | json }}{%- endif -%}
      {%- if settings.seo_instagram != blank and settings.seo_facebook != blank -%},{%- endif -%}
      {%- if settings.seo_facebook != blank -%}{{ settings.seo_facebook | json }}{%- endif -%}
    ]
    {%- endif %}
  }
</script>

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": {{ site | append: '/#website' | json }},
      "name": "British Lingerie Studio",
      "alternateName": "BLS",
      "url": {{ site | append: '/' | json }},
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ site }}{{ routes.search_url }}?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- liquid
  assign crumb = blank
  if request.page_type == 'product'
    for c in product.collections
      assign c_head = c.handle | slice: 0, 5
      if c.handle != 'all' and c.handle != 'frontpage' and c_head != 'avada'
        assign crumb = c
        break
      endif
    endfor
  endif
-%}
{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ site | append: collection.url | json }} }
      ]
    }
  </script>
{%- elsif request.page_type == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ site | append: '/' | json }} },
        {%- if crumb != blank %}
        { "@type": "ListItem", "position": 2, "name": {{ crumb.title | json }}, "item": {{ site | append: crumb.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ site | append: product.url | json }} }
        {%- else %}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ site | append: product.url | json }} }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}
{% elsif page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
