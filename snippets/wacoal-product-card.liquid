{%- doc -%}
  Product card used by the Wacoal-style sections (Best Sellers carousel, collection grid).
  @param {product} product - The product
  @param {string} [badge] - Text of the white pill on the photo, e.g. Best Seller
  @param {number} [new_days] - Show "New arrival" for products published in the last this many days (default 30, 0 = off)
  @param {boolean} [no_size_flag] - Hide the size range pill (S-XL / Up to E cup)
  @param {boolean} [show_sizes] - List the sizes in stock under the price (instead of the size range pill)
  @param {string} [sizes] - The img sizes attribute for the photo
  @param {boolean} [eager] - Load the photo straight away (first row of a grid)
{%- enddoc -%}
{%- liquid
  assign front = product.featured_image
  assign back = blank
  if product.images.size > 1
    assign back = product.images[1]
  endif
  assign title = product.title | remove_first: 'BLS - ' | remove_first: 'BLS-' | remove_first: 'BLS '
  assign style_no = product.selected_or_first_available_variant.sku | split: '-' | first
  assign color_option = blank
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_option = option
    endif
  endfor
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value

  comment
    Pills on the photo, Wacoal style: one status pill (badge, else New arrival, else Sale) and a size range pill.
  endcomment
  assign status_flag = badge
  if status_flag == blank
    assign days = new_days | default: 30
    assign is_new = false
    for tag in product.tags
      assign t = tag | downcase | strip
      if t == 'new' or t == 'new arrival' or t == 'new arrivals'
        assign is_new = true
        break
      endif
    endfor
    if is_new == false and days > 0 and product.published_at
      assign now_s = 'now' | date: '%s' | plus: 0
      assign published_s = product.published_at | date: '%s' | plus: 0
      assign age_days = now_s | minus: published_s | divided_by: 86400
      if age_days < days
        assign is_new = true
      endif
    endif
    if is_new
      assign status_flag = 'New arrival'
    elsif product.compare_at_price > product.price
      assign status_flag = 'Sale'
    endif
  endif

  assign size_flag = ''
  unless no_size_flag or show_sizes
    for option in product.options_with_values
      assign oname = option.name | downcase
      if oname != 'size'
        continue
      endif
      assign first_value = option.values.first | upcase | strip
      assign lead = first_value | slice: 0
      if '0123456789' contains lead
        comment band + cup sizes (34B..40DD): the biggest cup
        endcomment
        assign cups = 'AA,A,B,C,D,DD,E,DDD,F,FF,G,GG,H,HH,J,JJ,K' | split: ','
        assign max_cup = -1
        for value in option.values
          assign cup = value | upcase | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | strip
          for c in cups
            if c == cup and forloop.index0 > max_cup
              assign max_cup = forloop.index0
            endif
          endfor
        endfor
        if max_cup >= 0
          assign size_flag = 'Up to ' | append: cups[max_cup] | append: ' cup'
        endif
      elsif option.values.size > 1
        assign from = option.values.first | split: '/' | first | strip
        assign to = option.values.last | split: '/' | last | strip
        assign size_flag = from | append: '-' | append: to
      endif
      break
    endfor
  endunless

  assign in_stock_sizes = ''
  if show_sizes
    for option in product.options_with_values
      assign oname = option.name | downcase
      if oname != 'size'
        continue
      endif
      assign size_index = option.position | minus: 1
      for value in option.values
        assign size_name = value | append: ''
        for variant in product.variants
          if variant.available and variant.options[size_index] == size_name
            assign in_stock_sizes = in_stock_sizes | append: size_name | append: '|'
            break
          endif
        endfor
      endfor
      break
    endfor
  endif
  assign in_stock_sizes = in_stock_sizes | split: '|'
-%}
<div class="wac-card">
  <div class="wac-card__top">
    <a class="wac-card__image-link" href="{{ product.url }}" aria-label="{{ title | escape }}">
      <span class="wac-card__flip">
        {%- if front -%}
          <img class="wac-card__img wac-card__img--front" src="{{ front | image_url: width: 560 }}" srcset="{{ front | image_url: width: 280 }} 280w, {{ front | image_url: width: 560 }} 560w" sizes="{{ sizes | default: '278px' }}" width="{{ front.width }}" height="{{ front.height }}" alt="{{ front.alt | default: title | escape }}" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- else -%}
          <span class="wac-card__img wac-card__img--front wac-card__img--empty"></span>
        {%- endif -%}
        {%- if back != blank -%}
          <img class="wac-card__img wac-card__img--back" src="{{ back | image_url: width: 560 }}" width="{{ back.width }}" height="{{ back.height }}" alt="" loading="lazy">
        {%- endif -%}
      </span>
      {%- if status_flag != blank or size_flag != blank -%}
        <span class="wac-card__flags">
          {%- if status_flag != blank -%}
            <span class="wac-card__flag">{{ status_flag | escape }}</span>
          {%- endif -%}
          {%- if size_flag != blank -%}
            <span class="wac-card__flag">{{ size_flag | escape }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </a>

    <div class="wac-card__info">
      {%- if color_option != blank -%}
        <ul class="wac-card__swatches" role="list" aria-label="Colours">
          {%- for value in color_option.values limit: 5 -%}
            {%- liquid
              assign key = value | downcase | strip
              assign hex = '#d9d2cb'
              case key
                when 'black' or 'jet black'
                  assign hex = '#000000'
                when 'white' or 'ivory' or 'off white' or 'off-white'
                  assign hex = '#f5f1ea'
                when 'skin' or 'nude' or 'beige' or 'sand'
                  assign hex = '#e8c9a8'
                when 'cream'
                  assign hex = '#f2e6d0'
                when 'red'
                  assign hex = '#c8102e'
                when 'maroon' or 'wine' or 'burgundy'
                  assign hex = '#6e1e2b'
                when 'pink' or 'baby pink' or 'light pink'
                  assign hex = '#f3b5c6'
                when 'hot pink' or 'fuchsia' or 'magenta'
                  assign hex = '#e3348a'
                when 'peach'
                  assign hex = '#f6c3a4'
                when 'purple' or 'violet'
                  assign hex = '#7e286f'
                when 'lilac' or 'lavender' or 'mauve'
                  assign hex = '#b89bc9'
                when 'blue' or 'royal blue'
                  assign hex = '#2b55a3'
                when 'navy' or 'navy blue' or 'dark blue'
                  assign hex = '#1b2a4a'
                when 'sky blue' or 'light blue' or 'baby blue'
                  assign hex = '#a9cfe8'
                when 'teal' or 'turquoise'
                  assign hex = '#2a8c8c'
                when 'green' or 'dark green' or 'bottle green'
                  assign hex = '#2f6b3a'
                when 'olive'
                  assign hex = '#7a7a3a'
                when 'mint' or 'sea green'
                  assign hex = '#a7dcc6'
                when 'yellow' or 'mustard'
                  assign hex = '#e0b43a'
                when 'orange' or 'rust'
                  assign hex = '#d2691e'
                when 'grey' or 'gray' or 'light grey' or 'light gray'
                  assign hex = '#9a9a9a'
                when 'charcoal' or 'dark grey' or 'dark gray'
                  assign hex = '#4a4a4a'
                when 'brown' or 'coffee' or 'chocolate' or 'mocha'
                  assign hex = '#6b4226'
                when 'tan' or 'camel' or 'caramel'
                  assign hex = '#c69c6d'
                when 'gold' or 'golden'
                  assign hex = '#d4af37'
                when 'silver'
                  assign hex = '#c0c0c0'
                when 'multi' or 'mix' or 'multicolor' or 'multicolour' or 'printed' or 'print'
                  assign hex = 'linear-gradient(135deg,#e3348a 0 33%,#2b55a3 33% 66%,#e0b43a 66%)'
              endcase
            -%}
            <li class="wac-card__swatch{% if forloop.first %} is-active{% endif %}" title="{{ value | escape }}"><span class="wac-card__swatch-dot" style="background: {{ hex }};"></span></li>
          {%- endfor -%}
          {%- if color_option.values.size > 5 -%}
            <li class="wac-card__swatch-more" aria-hidden="true">+</li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <a class="wac-card__title-link" href="{{ product.url }}">
        <span class="wac-card__meta">
          <span>{{ product.vendor | escape }}</span>
          {%- if style_no != blank -%}<span>{{ style_no | escape }}</span>{%- endif -%}
        </span>
        <span class="wac-card__title">{{ title | escape }}</span>
      </a>

      <div class="wac-card__price">
        <span class="wac-card__price-now">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <s class="wac-card__price-was">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </div>

      {%- if in_stock_sizes.size > 0 -%}
        <ul class="wac-card__sizes" role="list" aria-label="Sizes in stock">
          {%- for size_name in in_stock_sizes -%}<li>{{ size_name | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if rating != blank -%}
        <a class="wac-card__rating" href="{{ product.url }}#reviews" aria-label="Rated {{ rating.rating }} out of 5 from {{ rating_count }} reviews">
          <span class="wac-card__stars" style="--wac-rating: {{ rating.rating | times: 1.0 | divided_by: 5.0 | times: 100 | round: 1 }}%;" aria-hidden="true">
            <span class="wac-card__stars-bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="wac-card__stars-fg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </span>
          <span class="wac-card__rating-count">({{ rating_count }})</span>
          <svg class="wac-card__rating-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
