{%- doc -%}
  Size Guide link + popup for the product page, ported from the live theme (sections/product-template.liquid
  + snippets/sizeChart-popup.liquid there). The rules are child blocks:
  - "Size chart" (_bls-size-chart): the first one that matches the product is the chart.
  - "Extra size chart" (_bls-size-chart-extra): every match is added as its own tab.
  Each child prints a marker only when it matches; no match = no link. "Sister Size" shows when the
  chosen chart has it switched on.
{%- enddoc -%}
{%- capture rules -%}{% content_for 'blocks' %}{%- endcapture -%}
{%- render 'bls-size-guide-ui',
  rules: rules,
  uid: block.id,
  link_label: block.settings.link_label,
  modal_title: block.settings.modal_title,
  alignment: block.settings.alignment,
  sister_image: block.settings.sister_image,
  sister_label: block.settings.sister_label,
  attrs: block.shopify_attributes
-%}

{% schema %}
{
  "name": "BLS size guide",
  "tag": null,
  "blocks": [{ "type": "_bls-size-chart" }, { "type": "_bls-size-chart-extra" }],
  "settings": [
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Size Guide" },
    { "type": "text", "id": "modal_title", "label": "Popup title", "default": "Size Chart" },
    { "type": "select", "id": "alignment", "label": "Link alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "right" },
    { "type": "image_picker", "id": "sister_image", "label": "Sister Size chart", "info": "Shown when the chosen chart has Sister Size switched on." },
    { "type": "text", "id": "sister_label", "label": "Sister Size label", "default": "Sister Size" }
  ],
  "presets": [{ "name": "BLS size guide" }]
}
{% endschema %}
