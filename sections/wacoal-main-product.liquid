{% comment %}
  Product page (Wacoal product page): photo slider on the left (sticky on desktop), and on the
  right the title and price, colour circles, size buttons (bra sizes like 34B split into BAND
  and CUP), quantity, add to cart, feature cards, accordions and a "Complete your look" row.
  Colours sold as separate products (same style number at the start of the SKU) show as links;
  colours sold as variants show as buttons.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign p = product
  assign first_v = p.selected_or_first_available_variant
  assign picked = p.selected_variant
  assign style_no = p.variants.first.sku | split: '-' | first | strip

  assign color_index = -1
  assign color_option = blank
  for option in p.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_index = forloop.index0
      assign color_option = option
    endif
  endfor
  assign multi_color = false
  if color_option != blank and color_option.values.size > 1
    assign multi_color = true
  endif

  capture color_name
    render 'wacoal-product-color', product: p
  endcapture
  assign color_name = color_name | strip
  if multi_color
    assign color_name = first_v.options[color_index]
    if picked
      assign color_name = picked.options[color_index]
    endif
  endif

  assign title = p.title | remove_first: 'BLS - ' | remove_first: 'BLS-' | remove_first: 'BLS '
  assign title_parts = title | split: ' - '
  if title_parts.size > 1 and color_name != blank
    assign last_part = title_parts.last | downcase | strip
    assign color_down = color_name | downcase
    if last_part == color_down
      assign keep = title_parts.size | minus: 1
      assign title = ''
      for part in title_parts limit: keep
        unless forloop.first
          assign title = title | append: ' - '
        endunless
        assign title = title | append: part
      endfor
    endif
  endif

  assign badge = ''
  assign badge_entries = ss.badge_tags | split: ','
  for entry in badge_entries
    assign pair = entry | split: '='
    assign want = pair.first | strip | downcase
    assign shown = pair.last | strip
    for tag in p.tags
      assign t = tag | downcase
      if t == want
        assign badge = shown
        break
      endif
    endfor
    if badge != ''
      break
    endif
  endfor
  if badge == '' and p.compare_at_price > p.price
    assign badge = 'Sale'
  endif

  assign rating = p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value

  comment
    Size charts, same rules as the live theme's product-template: the first "Size chart" block
    whose tags or title phrases match is the chart; every matching "Extra size chart" is a tab.
  endcomment
  assign sg_has_main = false
  assign sg_rules = ''
  assign sg_tags = p.tags | join: ',' | downcase | split: ','
  assign sg_title = p.title | downcase
  for block in section.blocks
    if block.type != 'size_chart' and block.type != 'extra_chart'
      continue
    endif
    if block.settings.image == blank and block.settings.table == blank
      continue
    endif
    if block.type == 'size_chart' and sg_has_main
      continue
    endif
    assign hit = false
    assign rule_tags = block.settings.tags | downcase | split: ','
    for rule_tag in rule_tags
      assign needle = rule_tag | strip
      if needle != '' and sg_tags contains needle
        assign hit = true
        break
      endif
    endfor
    unless hit
      assign phrases = block.settings.title_contains | downcase | split: ','
      for phrase in phrases
        assign needle = phrase | strip
        if needle != '' and sg_title contains needle
          assign hit = true
          break
        endif
      endfor
    endunless
    if hit
      comment
        A chart typed in as a table is shown instead of the image (no image to download).
      endcomment
      assign sg_src = ''
      assign sg_body = ''
      if block.settings.table != blank
        assign sg_body = '<template>' | append: block.settings.table | append: '</template>'
      elsif block.settings.image != blank
        assign sg_src = block.settings.image | image_url: width: 1400
      endif
      assign sg_alt = block.settings.image.alt | default: block.settings.title | escape
      if block.type == 'size_chart'
        assign sg_has_main = true
        assign sg_marker = '<span class="bls-sg-rule" data-kind="main" data-src="' | append: sg_src | append: '" data-alt="' | append: sg_alt | append: '"'
        if block.settings.show_sister_size
          assign sg_marker = sg_marker | append: ' data-sister'
        endif
        assign sg_marker = sg_marker | append: '>' | append: sg_body | append: '</span>'
      else
        assign sg_tab = block.settings.tab_label | default: 'More sizes' | escape
        assign sg_main_tab = block.settings.main_tab_label | escape
        assign sg_marker = '<span class="bls-sg-rule" data-kind="extra" data-src="' | append: sg_src | append: '" data-alt="' | append: sg_alt | append: '" data-tab="' | append: sg_tab | append: '" data-main-tab="' | append: sg_main_tab | append: '">' | append: sg_body | append: '</span>'
      endif
      assign sg_rules = sg_rules | append: sg_marker
    endif
  endfor

  assign images = p.media | where: 'media_type', 'image'
  if images.size == 0 and p.featured_image
    assign images = p.images
  endif

  comment
    Size option: the first option that is not the colour. Bra sizes (two digits then letters,
    e.g. 34B, 36DD) are split into a band list and a cup list.
  endcomment
  assign size_index = -1
  for option in p.options_with_values
    if forloop.index0 != color_index and size_index == -1
      assign size_index = forloop.index0
    endif
  endfor
  assign split_sizes = false
  assign bands = ''
  assign cups = ''
  if size_index > -1 and p.has_only_default_variant == false
    assign split_sizes = true
    assign size_option = p.options_with_values[size_index]
    for value in size_option.values
      assign v = value | strip | upcase
      assign b = v | slice: 0, 2
      assign b_num = b | plus: 0 | append: ''
      assign c = v | slice: 2, 10
      if b_num != b or c == blank or c contains ' ' or c contains '/' or c contains '-'
        assign split_sizes = false
        break
      endif
      assign c_first = c | slice: 0, 1
      assign c_first_num = c_first | plus: 0 | append: ''
      if c_first_num == c_first
        assign split_sizes = false
        break
      endif
      assign b_key = '|' | append: b | append: '|'
      unless bands contains b_key
        assign bands = bands | append: b_key
      endunless
      assign c_key = '|' | append: c | append: '|'
      unless cups contains c_key
        assign cups = cups | append: c_key
      endunless
    endfor
  endif
  if split_sizes
    assign band_list = bands | remove_first: '|' | split: '||' | sort
    assign band_list = band_list | join: ',' | remove: '|' | split: ','
    assign cup_order = 'AA,A,B,C,D,DD,DDD,E,F,FF,G,GG,H,HH,I,J,JJ,K'
    assign cup_order_list = cup_order | split: ','
    assign cup_list = ''
    for c in cup_order_list
      assign c_key = '|' | append: c | append: '|'
      if cups contains c_key
        assign cup_list = cup_list | append: c | append: ','
        assign cups = cups | remove: c_key
      endif
    endfor
    assign leftover = cups | remove_first: '|' | split: '||'
    for c in leftover
      assign c = c | remove: '|'
      if c != blank
        assign cup_list = cup_list | append: c | append: ','
      endif
    endfor
    assign cup_list = cup_list | split: ','
  endif

  assign picked_band = ''
  assign picked_cup = ''
  if picked and split_sizes
    assign picked_size = picked.options[size_index] | strip | upcase
    assign picked_band = picked_size | slice: 0, 2
    assign picked_cup = picked_size | slice: 2, 10
  endif

  assign siblings_url = ''
  if multi_color == false and style_no != blank
    assign q = style_no | url_encode
    assign siblings_url = routes.predictive_search_url | append: '?q=' | append: q | append: '&resources[type]=product&resources[limit]=10&resources[options][fields]=variants.sku&resources[options][unavailable_products]=last&section_id=wacoal-color-siblings'
  endif

  assign is_new = false
  for tag in p.tags
    assign t = tag | downcase
    if t == 'new'
      assign is_new = true
    endif
  endfor
  assign own_flag = ''
  if is_new
    assign own_flag = 'new'
  elsif p.compare_at_price > p.price
    assign own_flag = 'sale'
  endif

  assign shape = ss.photo_shape

  comment
    Split the description the way BLS writes it: intro text, lines starting with "-" (Features),
    then "Fabric & Care" and "Shipping & Returns" parts, and a closing "**" note. Descriptions
    with tables, images or video are not split.
  endcomment
  assign d_details = ''
  assign d_features = ''
  assign d_care = ''
  assign d_shipping = ''
  assign d_note = ''
  assign d_split = true
  if p.description contains '<table' or p.description contains '<img' or p.description contains '<iframe'
    assign d_split = false
  endif
  if d_split
    assign d_norm = p.description | replace: '<br/>', '<br>' | replace: '<br />', '<br>' | replace: '</p>', '<br>' | replace: '</div>', '<br>' | replace: '</li>', '<br>' | replace: '</h3>', '<br>' | replace: '</h4>', '<br>' | strip_newlines
    assign d_lines = d_norm | split: '<br>'
    assign bucket = 'details'
    assign list_open = false
    for line in d_lines
      assign t = line | strip_html | replace: '&nbsp;', ' ' | strip
      if t == blank
        continue
      endif
      assign key = t | downcase | replace: '&amp;', '&' | remove: ':' | strip
      case key
        when 'fabric & care' or 'fabric and care' or 'fabric/care' or 'care' or 'fabric' or 'care instructions'
          if list_open
            assign d_features = d_features | append: '</ul>'
            assign list_open = false
          endif
          assign bucket = 'care'
          continue
        when 'shipping & returns' or 'shipping and returns' or 'shipping & return' or 'shipping'
          if list_open
            assign d_features = d_features | append: '</ul>'
            assign list_open = false
          endif
          assign bucket = 'shipping'
          continue
        when 'details' or 'description'
          assign bucket = 'details'
          continue
        when 'features'
          assign bucket = 'features'
          continue
      endcase
      assign c2 = t | slice: 0, 2
      if c2 == '**'
        assign d_note = d_note | append: '<p>' | append: t | append: '</p>'
        continue
      endif
      assign c1 = t | slice: 0, 1
      if bucket == 'details' or bucket == 'features'
        if c1 == '-' or c1 == '•'
          unless list_open
            assign d_features = d_features | append: '<ul>'
            assign list_open = true
          endunless
          assign item = t | remove_first: c1 | strip
          assign d_features = d_features | append: '<li>' | append: item | append: '</li>'
          assign bucket = 'features'
        elsif bucket == 'features'
          if list_open
            assign d_features = d_features | append: '</ul>'
            assign list_open = false
          endif
          assign d_features = d_features | append: '<p><strong>' | append: t | append: '</strong></p>'
        else
          assign d_details = d_details | append: '<p>' | append: t | append: '</p>'
        endif
      elsif bucket == 'care'
        assign d_care = d_care | append: '<p>' | append: t | append: '</p>'
      else
        assign d_shipping = d_shipping | append: '<p>' | append: t | append: '</p>'
      endif
    endfor
    if list_open
      assign d_features = d_features | append: '</ul>'
    endif
    assign d_details = d_details | append: d_note
  endif
-%}

{%- capture size_guide -%}
  {%- if sg_rules != blank -%}
    {%- render 'bls-size-guide-ui',
      rules: sg_rules,
      uid: section.id,
      link_label: ss.size_guide_label,
      modal_title: 'Size Chart',
      alignment: 'right',
      sister_image: ss.sister_size_chart,
      sister_table: ss.sister_size_table,
      sister_label: 'Sister Size'
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  comment
    Breadcrumb collection: the one in the address (/collections/bras/products/...), else the first
    main menu collection the product is in, else its first collection.
  endcomment
  assign crumb = collection
  if crumb == blank
    assign p_handles = p.collections | map: 'handle' | join: '|' | prepend: '|' | append: '|'
    for link in linklists['main-menu'].links
      if link.type == 'collection_link'
        assign key = '|' | append: link.object.handle | append: '|'
        if p_handles contains key
          assign crumb = link.object
          break
        endif
      endif
    endfor
  endif
  comment
    Out-of-stock products drop out of the smart collections: fall back to the menu collection named
    like the product type (Panties, Bra/Bras, Sleep Wear ...), then any store collection (not app-made).
  endcomment
  if crumb == blank and p.type != blank
    assign type_lc = p.type | downcase | strip
    assign type_s = type_lc | append: 's'
    for link in linklists['main-menu'].links
      if link.type == 'collection_link'
        assign title_lc = link.title | downcase | strip
        if title_lc == type_lc or title_lc == type_s
          assign crumb = link.object
          break
        endif
      endif
    endfor
  endif
  if crumb == blank
    for c in p.collections
      assign c_head = c.handle | slice: 0, 5
      if c.handle != 'all' and c.handle != 'frontpage' and c_head != 'avada'
        assign crumb = c
        break
      endif
    endfor
  endif
-%}
{%- capture head -%}
  <nav class="wac-pdp__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    {%- if crumb != blank -%}
      <span class="wac-pdp__crumbs-sep" aria-hidden="true">/</span>
      <a href="{{ crumb.url }}">{{ crumb.title | downcase | escape }}</a>
    {%- endif -%}
  </nav>
  {%- if rating != blank -%}
    <a class="wac-pdp__rating" href="#reviews" aria-label="Rated {{ rating.rating }} out of 5 from {{ rating_count }} reviews">
      <span class="wac-card__stars" style="--wac-rating: {{ rating.rating | times: 1.0 | divided_by: 5.0 | times: 100 | round: 1 }}%;" aria-hidden="true">
        <span class="wac-card__stars-bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="wac-card__stars-fg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      </span>
      <span class="wac-pdp__rating-text">{{ rating.rating | round: 1 }} ({{ rating_count }})</span>
    </a>
  {%- endif -%}
  {%- if ss.brand_line != blank -%}
    <div class="wac-pdp__vendor">{{ ss.brand_line | escape }}</div>
  {%- endif -%}
  <h1 class="wac-pdp__title">{{ title | escape }}</h1>
  <div class="wac-pdp__price-row">
    <span class="wac-pdp__price" data-wac-price>
      {%- liquid
        assign shown_v = picked | default: first_v
      -%}
      <span class="wac-pdp__price-now">{{ shown_v.price | money }}</span>
      {%- if shown_v.compare_at_price > shown_v.price -%}
        <s class="wac-pdp__price-was">{{ shown_v.compare_at_price | money }}</s>
      {%- endif -%}
    </span>
    {%- if badge != '' -%}
      <span class="wac-pdp__flag">{{ badge | escape }}</span>
    {%- endif -%}
  </div>
  {%- if style_no != blank and ss.show_style -%}
    <div class="wac-pdp__style">{{ ss.style_label | escape }} {{ style_no | escape }}</div>
  {%- endif -%}
{%- endcapture -%}

<div
  class="wac-pdp wac-pdp--shape-{{ shape }}{% if ss.sticky_gallery %} wac-pdp--sticky{% endif %}"
  data-wac-pdp
  data-section-id="{{ section.id }}"
  data-product-id="{{ p.id }}"
  data-product-url="{{ p.url }}"
  data-handle="{{ p.handle }}"
  {% if siblings_url != blank %}data-siblings-url="{{ siblings_url }}"{% endif %}
>
  <div class="wac-pdp__head wac-pdp__head--mobile">{{ head }}</div>

  <div class="wac-pdp__container">
    <div class="wac-pdp__gallery{% if images.size > 1 %} wac-pdp__gallery--thumbs{% endif %}" data-wac-gallery>
      {%- if images.size > 1 -%}
        <div class="wac-pdp__thumbs" data-wac-thumbs aria-label="Choose a photo">
          {%- for media in images -%}
            {%- assign t_img = media.preview_image | default: media -%}
            <button type="button" class="wac-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-wac-thumb="{{ forloop.index0 }}" aria-label="Photo {{ forloop.index }} of {{ images.size }}">
              <img src="{{ t_img | image_url: width: 120 }}" srcset="{{ t_img | image_url: width: 60 }} 60w, {{ t_img | image_url: width: 120 }} 120w" sizes="44px" width="44" height="{{ 44 | divided_by: t_img.aspect_ratio | round }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="wac-pdp__frame">
        <div class="wac-pdp__slider" data-wac-slider tabindex="0" aria-label="Product photos">
          {%- for media in images -%}
            {%- liquid
              assign img = media.preview_image | default: media
              assign loading = 'lazy'
              if forloop.first
                assign loading = 'eager'
              endif
            -%}
            <div class="wac-pdp__slide" data-media-id="{{ media.id }}">
              <img
                class="wac-pdp__img"
                src="{{ img | image_url: width: 1200 }}"
                srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 749px) calc(100vw - 7px), (max-width: 1099px) 360px, 26vw"
                width="{{ img.width }}"
                height="{{ img.height }}"
                alt="{{ img.alt | default: title | escape }}"
                data-wac-zoom-src="{{ img | image_url: width: 2200 }}"
                loading="{{ loading }}"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            </div>
          {%- else -%}
            <div class="wac-pdp__slide"><span class="wac-pdp__img wac-pdp__img--empty"></span></div>
          {%- endfor -%}
        </div>
        {%- if images.size > 0 -%}
          <button type="button" class="wac-pdp__zoom-btn" data-wac-zoom-open aria-label="Zoom photo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8M10.5 7.5v6M7.5 10.5h6"/></svg>
          </button>
        {%- endif -%}
        {%- if images.size > 1 -%}
          <div class="wac-pdp__arrows">
            <button type="button" class="wac-pdp__arrow" data-wac-prev aria-label="Previous photo" disabled>
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M17 5H1m4.5-4L1 5l4.5 4" stroke="currentColor" stroke-width="1.2"/></svg>
            </button>
            <button type="button" class="wac-pdp__arrow" data-wac-next aria-label="Next photo">
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5h16m-4.5-4L17 5l-4.5 4" stroke="currentColor" stroke-width="1.2"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
      {%- if images.size > 1 -%}
        <div class="wac-pdp__dots">
          {%- for media in images -%}
            <button type="button" class="wac-pdp__dot{% if forloop.first %} is-active{% endif %}" data-wac-dot="{{ forloop.index0 }}" aria-label="Photo {{ forloop.index }} of {{ images.size }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <dialog class="wac-zoom" data-wac-zoom aria-label="Product photos, zoomed">
      <div class="wac-zoom__bar">
        <span class="wac-zoom__count" data-wac-zoom-count></span>
        <button type="button" class="wac-zoom__close" data-wac-zoom-close aria-label="Close">&#215;</button>
      </div>
      <div class="wac-zoom__stage" data-wac-zoom-stage>
        <img class="wac-zoom__img" data-wac-zoom-img alt="">
      </div>
      <button type="button" class="wac-zoom__nav wac-zoom__nav--prev" data-wac-zoom-prev aria-label="Previous photo">
        <svg width="12" height="20" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M8.5 1.5L2 8l6.5 6.5" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
      <button type="button" class="wac-zoom__nav wac-zoom__nav--next" data-wac-zoom-next aria-label="Next photo">
        <svg width="12" height="20" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M1.5 1.5L8 8l-6.5 6.5" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
      <p class="wac-zoom__hint">Click the photo to zoom in</p>
    </dialog>

    <div class="wac-pdp__wrap">
      <div class="wac-pdp__head wac-pdp__head--desktop">{{ head }}</div>

      <form class="wac-pdp__info" method="post" action="{{ routes.cart_add_url }}" data-wac-form novalidate>
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" value="{% if picked or p.has_only_default_variant %}{{ shown_v.id }}{% endif %}" data-wac-id>

        {%- if color_name != blank -%}
          <div class="wac-pdp__option wac-pdp__option--color">
            <h2 class="wac-pdp__label"><strong>{{ ss.color_label | escape }}:</strong> <span data-wac-color-name>{{ color_name | escape }}</span></h2>
            <ul class="wac-pdp__swatches" role="list" data-wac-swatches>
              {%- if multi_color -%}
                {%- for value in color_option.values -%}
                  {%- liquid
                    assign vname = value.name
                    assign v_img = blank
                    for v in p.variants
                      if v.options[color_index] == vname and v.featured_image
                        assign v_img = v.featured_image
                        break
                      endif
                    endfor
                    assign active = false
                    if vname == color_name
                      assign active = true
                    endif
                  -%}
                  {%- render 'wacoal-pdp-swatch', name: vname, value: vname, image: v_img, active: active -%}
                {%- endfor -%}
              {%- else -%}
                {%- render 'wacoal-pdp-swatch', name: color_name, url: p.url, handle: p.handle, image: p.featured_image, active: true, flag: own_flag -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- unless p.has_only_default_variant -%}
          {%- for option in p.options_with_values -%}
            {%- if forloop.index0 == color_index -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign o_index = forloop.index0
              assign is_size = false
              if o_index == size_index
                assign is_size = true
              endif
            -%}
            {%- if is_size and split_sizes -%}
              <div class="wac-pdp__option" data-wac-band-group>
                <div class="wac-pdp__option-head">
                  <h2 class="wac-pdp__label"><strong>{{ ss.band_label | escape }}:</strong> <span data-wac-picked-label>{{ picked_band }}</span></h2>
                  {{ size_guide }}
                </div>
                <ul class="wac-pdp__sizes" role="list">
                  {%- for b in band_list -%}
                    {%- liquid
                      assign ok = false
                      for v in p.variants
                        assign vs = v.options[size_index] | strip | upcase | slice: 0, 2
                        if vs == b and v.available
                          assign ok = true
                          break
                        endif
                      endfor
                    -%}
                    <li class="wac-pdp__size">
                      <input type="radio" class="wac-pdp__radio" id="{{ section.id }}-band-{{ b }}" name="{{ section.id }}-band" value="{{ b }}" data-wac-band{% if b == picked_band %} checked{% endif %}>
                      <label for="{{ section.id }}-band-{{ b }}"{% unless ok %} class="is-unavailable"{% endunless %}>{{ b }}</label>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
              <div class="wac-pdp__option" data-wac-cup-group>
                <h2 class="wac-pdp__label"><strong>{{ ss.cup_label | escape }}:</strong> <span data-wac-picked-label>{{ picked_cup }}</span></h2>
                <ul class="wac-pdp__sizes" role="list">
                  {%- for c in cup_list -%}
                    {%- liquid
                      assign ok = false
                      for v in p.variants
                        assign vs = v.options[size_index] | strip | upcase | slice: 2, 10
                        if vs == c and v.available
                          assign ok = true
                          break
                        endif
                      endfor
                    -%}
                    <li class="wac-pdp__size">
                      <input type="radio" class="wac-pdp__radio" id="{{ section.id }}-cup-{{ c }}" name="{{ section.id }}-cup" value="{{ c }}" data-wac-cup{% if c == picked_cup %} checked{% endif %}>
                      <label for="{{ section.id }}-cup-{{ c }}"{% unless ok %} class="is-unavailable"{% endunless %}>{{ c }}</label>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- else -%}
              <div class="wac-pdp__option" data-wac-option-group="{{ o_index }}">
                <div class="wac-pdp__option-head">
                  <h2 class="wac-pdp__label"><strong>{{ option.name | escape }}:</strong> <span data-wac-picked-label>{% if picked %}{{ picked.options[o_index] | escape }}{% endif %}</span></h2>
                  {%- if is_size -%}{{ size_guide }}{%- endif -%}
                </div>
                <ul class="wac-pdp__sizes" role="list">
                  {%- for value in option.values -%}
                    <li class="wac-pdp__size">
                      <input type="radio" class="wac-pdp__radio" id="{{ section.id }}-o{{ o_index }}-{{ forloop.index }}" name="{{ section.id }}-o{{ o_index }}" value="{{ value | escape }}" data-wac-option="{{ o_index }}"{% if picked and picked.options[o_index] == value %} checked{% endif %}>
                      <label for="{{ section.id }}-o{{ o_index }}-{{ forloop.index }}"{% unless value.available %} class="is-unavailable"{% endunless %}>{{ value | escape }}</label>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        <div class="wac-pdp__qty">
          <label class="wac-pdp__label wac-pdp__label--qty" for="{{ section.id }}-qty"><strong>{{ ss.quantity_label | escape }}</strong></label>
          <div class="wac-pdp__qty-box">
            <button type="button" class="wac-pdp__qty-btn" data-wac-minus aria-label="Decrease quantity" disabled>
              <svg width="12" height="2" viewBox="0 0 12 1.2" aria-hidden="true"><path fill="currentColor" d="M0 0h12v1.2H0z"/></svg>
            </button>
            <input class="wac-pdp__qty-input" id="{{ section.id }}-qty" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" data-wac-qty>
            <button type="button" class="wac-pdp__qty-btn" data-wac-plus aria-label="Increase quantity">
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M5.25 0v5.25H0v1.5h5.25V12h1.5V6.75H12v-1.5H6.75V0z"/></svg>
            </button>
          </div>
        </div>

        <div class="wac-pdp__add-row">
        <button
          type="submit"
          class="wac-pdp__add"
          data-wac-add
          data-label-select="{{ ss.select_label | escape }}"
          data-label-add="{{ ss.add_label | escape }}"
          data-label-sold="{{ ss.sold_out_label | escape }}"
          data-label-adding="{{ ss.adding_label | escape }}"
          data-label-added="{{ ss.added_label | escape }}"
        >
          {%- if p.available == false -%}
            {{ ss.sold_out_label | escape }}
          {%- elsif picked or p.has_only_default_variant -%}
            {{ ss.add_label | escape }}
          {%- else -%}
            {{ ss.select_label | escape }}
          {%- endif -%}
        </button>
        {% render 'wacoal-wishlist-button', product: p, class: 'wac-pdp__wish' %}
        </div>
        <p class="wac-pdp__message" data-wac-message role="status" aria-live="polite" hidden></p>

        {%- if ss.ship_text != blank -%}
          <div class="wac-pdp__ship">{{ ss.ship_text }}</div>
        {%- endif -%}
        {%- if ss.note_text != blank -%}
          <div class="wac-pdp__note">{{ ss.note_text }}</div>
        {%- endif -%}
        {%- if ss.show_share -%}
          {% render 'wacoal-share', product: p %}
        {%- endif -%}
      </form>

      {%- capture features -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'feature' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign f_title = ''
            assign entries = block.settings.tags | split: ','
            for entry in entries
              assign pair = entry | split: '='
              assign want = pair.first | strip | downcase
              if want == blank
                continue
              endif
              assign shown = ''
              if pair.size > 1
                assign shown = pair.last | strip
              endif
              assign is_prefix = false
              if want contains '*'
                assign is_prefix = true
                assign want = want | remove: '*'
              endif
              for tag in p.tags
                assign t = tag | downcase | strip
                if is_prefix
                  assign t_head = t | slice: 0, want.size
                  if t_head == want
                    assign f_title = tag | slice: want.size, 100 | strip
                    break
                  endif
                elsif t == want
                  assign f_title = shown | default: tag
                  break
                endif
              endfor
              if f_title != ''
                break
              endif
            endfor
          -%}
          {%- if f_title != '' -%}
            <div class="wac-pdp__feature{% if block.settings.text == blank %} is-static{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.text != blank -%}
                <button type="button" class="wac-pdp__feature-head" data-wac-feature aria-expanded="false">
              {%- else -%}
                <div class="wac-pdp__feature-head">
              {%- endif -%}
                <span class="wac-pdp__feature-cat">{{ block.settings.label | escape }}</span>
                <span class="wac-pdp__feature-row">
                  <span class="wac-pdp__feature-title">{{ f_title | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <svg class="wac-pdp__feature-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                  {%- endif -%}
                </span>
              {%- if block.settings.text != blank -%}
                </button>
                <div class="wac-pdp__feature-body" hidden>{{ block.settings.text }}</div>
              {%- else -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if features != blank -%}
        <div class="wac-pdp__features">{{ features }}</div>
      {%- endif -%}

      {%- capture rows -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'accordion' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            if block.settings.only_tags != blank
              assign show = false
              assign only = block.settings.only_tags | downcase | split: ','
              for tag in p.tags
                assign t = tag | downcase | strip
                for o in only
                  assign o = o | strip
                  if o == t
                    assign show = true
                  endif
                endfor
              endfor
              unless show
                continue
              endunless
            endif
            assign body = ''
            case block.settings.source
              when 'description'
                assign body = p.description
              when 'details'
                assign body = d_details
                if d_split == false
                  assign body = p.description
                endif
              when 'features'
                assign body = d_features
              when 'care'
                assign body = d_care
              when 'shipping'
                assign body = d_shipping
              when 'page'
                assign body = block.settings.page.content
              else
                assign body = block.settings.text
            endcase
            if body == blank and block.settings.source != 'description' and block.settings.source != 'details'
              assign body = block.settings.text
            endif
          -%}
          {%- if body != blank -%}
            <details class="wac-pdp__acc"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
              <summary class="wac-pdp__acc-head">
                <span>{{ block.settings.heading | escape }}</span>
                <span class="wac-pdp__acc-icon" aria-hidden="true">
                  <svg class="wac-pdp__acc-plus" width="12" height="12" viewBox="0 0 12 12"><path fill="currentColor" d="M5.25 0v5.25H0v1.5h5.25V12h1.5V6.75H12v-1.5H6.75V0z"/></svg>
                  <svg class="wac-pdp__acc-minus" width="12" height="2" viewBox="0 0 12 1.2"><path fill="currentColor" d="M0 0h12v1.2H0z"/></svg>
                </span>
              </summary>
              <div class="wac-pdp__acc-body rte">{{ body }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if rows != blank -%}
        <div class="wac-pdp__accs">{{ rows }}</div>
      {%- endif -%}

      {%- if rating != blank and rating_count > 0 -%}
        <a class="wac-pdp__reviews-row" href="#reviews">
          <span>Reviews ({{ rating_count }})</span>
          <span class="wac-pdp__reviews-score">
            <span class="wac-card__stars" style="--wac-rating: {{ rating.rating | times: 1.0 | divided_by: 5.0 | times: 100 | round: 1 }}%;" aria-hidden="true">
              <span class="wac-card__stars-bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              <span class="wac-card__stars-fg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </span>
            {{ rating.rating | round: 1 }}/5
          </span>
        </a>
      {%- endif -%}

      {%- liquid
        assign match = ss.match_collection
        assign match_count = 0
      -%}
      {%- if match != blank and match.products_count > 0 -%}
        {%- capture match_cards -%}
          {%- for item in match.products -%}
            {%- if item.id == p.id -%}{%- continue -%}{%- endif -%}
            {%- if match_count >= ss.match_limit -%}{%- break -%}{%- endif -%}
            {%- assign match_count = match_count | plus: 1 -%}
            {%- render 'wacoal-carousel-card', product: item, sizes: '220px' -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if match_count > 0 -%}
          <div class="wac-pdp__match" data-wac-carousel>
            <div class="wac-pdp__match-head">
              <h3 class="wac-pdp__match-title">{{ ss.match_heading | escape }}</h3>
              {%- if match_count > 2 -%}
                <div class="wac-pdp__match-arrows">
                  <button type="button" class="wac-pdp__match-arrow" data-wac-carousel-prev aria-label="Previous products" disabled>
                    <svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M8.5 1.5L2 8l6.5 6.5" stroke="currentColor" stroke-width="1.5"/></svg>
                  </button>
                  <button type="button" class="wac-pdp__match-arrow" data-wac-carousel-next aria-label="Next products">
                    <svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M1.5 1.5L8 8l-6.5 6.5" stroke="currentColor" stroke-width="1.5"/></svg>
                  </button>
                </div>
              {%- endif -%}
            </div>
            <ul class="wac-pdp__match-list" role="list" data-wac-carousel-list>{{ match_cards }}</ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- capture bar_dot -%}{%- render 'wacoal-color-hex', name: color_name -%}{%- endcapture -%}
  <div class="wac-pdp-bar" data-wac-bar aria-hidden="true">
    <div class="wac-pdp-bar__inner">
      <div class="wac-pdp-bar__info">
        <span class="wac-pdp-bar__title">{{ title | escape }}</span>
        <span class="wac-pdp-bar__price" data-wac-bar-price>{{ shown_v.price | money }}</span>
      </div>
      {%- if color_name != blank -%}
        <div class="wac-pdp-bar__color">
          <span class="wac-pdp-bar__dot" style="background: {{ bar_dot | strip | default: '#d9d2cb' }};"></span>
          <span>Color: <span data-wac-bar-color>{{ color_name | escape }}</span></span>
        </div>
      {%- endif -%}
      <button type="button" class="wac-pdp-bar__btn" data-wac-bar-btn tabindex="-1">{{ ss.select_label | escape }}</button>
    </div>
  </div>

  <script type="application/json" data-wac-pdp-json>
    {
      "colorIndex": {{ color_index }},
      "sizeIndex": {{ size_index }},
      "split": {{ split_sizes }},
      "multiColor": {{ multi_color }},
      "variants": [
        {%- for v in p.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "available": {{ v.available }},
            "price": {{ v.price | money | json }},
            "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script type="application/ld+json">{{ p | structured_data }}</script>
</div>

<script type="module" src="{{ 'wacoal-product.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Wacoal product",
  "tag": "section",
  "class": "wac-section-pdp",
  "max_blocks": 40,
  "settings": [
    { "type": "header", "content": "Photos" },
    { "type": "select", "id": "photo_shape", "label": "Photo shape", "options": [ { "value": "wacoal", "label": "Wacoal frame (592 x 695)" }, { "value": "portrait", "label": "Portrait 2:3" }, { "value": "natural", "label": "Photo's own shape" } ], "default": "wacoal" },
    { "type": "checkbox", "id": "sticky_gallery", "label": "Photos stay in view while scrolling (desktop)", "default": true },
    { "type": "header", "content": "Title area" },
    { "type": "text", "id": "brand_line", "label": "Line above the title", "default": "British Lingerie Studio", "info": "Leave empty to hide." },
    { "type": "checkbox", "id": "show_style", "label": "Show style number", "default": true, "info": "Taken from the start of the SKU, e.g. BLSAUPD04." },
    { "type": "text", "id": "style_label", "label": "Style number label", "default": "Style" },
    { "type": "text", "id": "badge_tags", "label": "Badge by tag", "default": "Best Seller, Bestseller=Best Seller, new=New", "info": "Tags that show a pill next to the price, separated by commas. Use tag=Text to change the wording. Products on sale show Sale when no tag matches." },
    { "type": "header", "content": "Options" },
    { "type": "text", "id": "color_label", "label": "Colour label", "default": "Color" },
    { "type": "text", "id": "band_label", "label": "Band label", "default": "Band", "info": "Bra sizes like 34B are split into band and cup." },
    { "type": "text", "id": "cup_label", "label": "Cup label", "default": "Cup" },
    { "type": "text", "id": "size_guide_label", "label": "Size guide link text", "default": "Size Guide", "info": "The charts are the Size chart / Extra size chart blocks: the first Size chart whose tags or title match is shown; each matching Extra size chart is a tab." },
    { "type": "image_picker", "id": "sister_size_chart", "label": "Sister Size chart", "info": "Shown on charts that have Sister Size switched on." },
    { "type": "html", "id": "sister_size_table", "label": "Sister Size chart as a table", "info": "Shown instead of the image when filled." },
    { "type": "text", "id": "quantity_label", "label": "Quantity label", "default": "Quantity" },
    { "type": "header", "content": "Add to cart" },
    { "type": "text", "id": "select_label", "label": "Button before a size is picked", "default": "Select your size" },
    { "type": "text", "id": "add_label", "label": "Button text", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out text", "default": "Sold out" },
    { "type": "text", "id": "adding_label", "label": "While adding", "default": "Adding..." },
    { "type": "text", "id": "added_label", "label": "After adding", "default": "Added to cart" },
    { "type": "richtext", "id": "ship_text", "label": "Bold line under the button", "default": "<p>Free shipping on orders above Rs.9,999</p>" },
    { "type": "richtext", "id": "note_text", "label": "Small text under that", "default": "<p>Cash on delivery available.</p>" },
    { "type": "header", "content": "Complete your look" },
    { "type": "text", "id": "match_heading", "label": "Heading", "default": "Complete your look" },
    { "type": "collection", "id": "match_collection", "label": "Products from", "info": "Leave empty to hide the row." },
    { "type": "range", "id": "match_limit", "label": "Number of products", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "header", "content": "Wishlist and share" },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        { "type": "text", "id": "label", "label": "Card label", "default": "Padding" },
        { "type": "text", "id": "tags", "label": "Tags to look for", "default": "Padded, Paded=Padded, Light Padded, Non Padded, Non-Paded=Non Padded", "info": "The first product tag found shows as the card title. Separate with commas; tag=Title changes the wording; Fabric_* takes the text after Fabric_." },
        { "type": "richtext", "id": "text", "label": "Text when the card is opened", "info": "Optional." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details" },
        { "type": "select", "id": "source", "label": "Content", "options": [ { "value": "details", "label": "Description: intro text" }, { "value": "features", "label": "Description: lines starting with -" }, { "value": "care", "label": "Description: Fabric & Care part" }, { "value": "shipping", "label": "Description: Shipping & Returns part" }, { "value": "description", "label": "Whole product description" }, { "value": "text", "label": "Text below" }, { "value": "page", "label": "A page" } ], "default": "text" },
        { "type": "richtext", "id": "text", "label": "Text", "info": "Also used when the chosen description part is missing." },
        { "type": "page", "id": "page", "label": "Page" },
        { "type": "checkbox", "id": "open", "label": "Open when the page loads", "default": false },
        { "type": "text", "id": "only_tags", "label": "Only on products tagged", "info": "Optional. Tags separated by commas, e.g. Bras." }
      ]
    },
    {
      "type": "size_chart",
      "name": "Size chart",
      "settings": [
        { "type": "text", "id": "title", "label": "Name (only shown in the editor)" },
        { "type": "image_picker", "id": "image", "label": "Chart image" },
        { "type": "html", "id": "table", "label": "Chart as a table", "info": "Shown instead of the image when filled. Loads faster and stays sharp on phones." },
        { "type": "text", "id": "tags", "label": "Product tags", "info": "Comma separated, case ignored. Any one is enough." },
        { "type": "text", "id": "title_contains", "label": "Or title contains", "info": "Comma separated phrases, case ignored." },
        { "type": "checkbox", "id": "show_sister_size", "label": "Show the Sister Size link", "default": false }
      ]
    },
    {
      "type": "extra_chart",
      "name": "Extra size chart",
      "settings": [
        { "type": "text", "id": "title", "label": "Name (only shown in the editor)" },
        { "type": "image_picker", "id": "image", "label": "Chart image" },
        { "type": "html", "id": "table", "label": "Chart as a table", "info": "Shown instead of the image when filled." },
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "More sizes" },
        { "type": "text", "id": "main_tab_label", "label": "Rename the main chart's tab", "info": "Optional, e.g. Bra size." },
        { "type": "text", "id": "tags", "label": "Product tags", "info": "Comma separated, case ignored. Any one is enough." },
        { "type": "text", "id": "title_contains", "label": "Or title contains", "info": "Comma separated phrases, case ignored." }
      ]
    }
  ],
  "presets": [ { "name": "Wacoal product" } ],
  "enabled_on": { "templates": [ "product" ] }
}
{% endschema %}
