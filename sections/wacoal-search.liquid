{% comment %}
  Search results page in the collection page's design: breadcrumb + caps title, a search box,
  "Shop by type" pills, then the same pill filter bar, filter drawer, sort, 4-up grid of site cards
  and infinite load as sections/wacoal-main-collection.liquid (script: assets/wacoal-collection.js).
  Non-product results (pages, blog posts) show as small text cards; filtering and sorting keep to
  products (type=product).
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign terms = search.terms
  assign sort_by = search.sort_by | default: 'relevance'
  assign active_count = 0
  for filter in search.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign q_param = terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: q_param | append: '&type=product&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- capture filter_icon -%}
  <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 2h18M0 8h18" stroke="currentColor" stroke-width="1"/><circle cx="5" cy="2" r="1.6" fill="#fff" stroke="currentColor"/><circle cx="13" cy="8" r="1.6" fill="#fff" stroke="currentColor"/></svg>
{%- endcapture -%}
{%- capture chevron -%}
  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcapture -%}
{%- capture hidden_query -%}
  <input type="hidden" name="q" value="{{ terms | escape }}">
  <input type="hidden" name="type" value="product">
  <input type="hidden" name="options[prefix]" value="last">
{%- endcapture -%}

<section class="wac-colhead wac-srch-head">
  <div class="wac-colhead__container">
    <nav class="wac-colhead__breadcrumb" aria-label="Breadcrumb">
      <a class="wac-colhead__crumb" href="{{ routes.root_url }}">Home</a>
      <span class="wac-colhead__sep" aria-hidden="true">/</span>
      <span class="wac-colhead__current" aria-current="page">search</span>
    </nav>

    <h1 class="wac-colhead__title">
      {%- if search.performed -%}
        Results for &ldquo;{{ terms | escape }}&rdquo;
      {%- else -%}
        {{ ss.heading | default: 'Search' | escape }}
      {%- endif -%}
    </h1>
    {%- if search.performed -%}
      <p class="wac-srch__count">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</p>
    {%- endif -%}

    <form class="wac-srch__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="WacSearch-{{ section.id }}">Search</label>
      <input id="WacSearch-{{ section.id }}" type="search" name="q" value="{{ terms | escape }}" placeholder="{{ ss.placeholder | escape }}" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
    </form>

    {%- render 'wacoal-search-pills' -%}
  </div>
</section>

<div class="wac-coll wac-srch" data-wac-coll id="WacColl-{{ section.id }}">
  {%- if search.performed and search.results_count > 0 -%}
    {%- paginate search.results by ss.per_page -%}
      <form class="wac-coll__bar" method="get" action="{{ routes.search_url }}" data-wac-inline-form>
        {{ hidden_query }}
        <div class="wac-coll__bar-left">
          <button type="button" class="wac-coll__pill wac-coll__pill--filter" data-wac-drawer-open aria-controls="WacDrawer-{{ section.id }}">
            <span>Filter</span>
            {%- if active_count > 0 -%}<span class="wac-coll__count">{{ active_count }}</span>{%- endif -%}
            {{ filter_icon }}
          </button>

          {%- if ss.inline_filters and search.filters.size > 0 -%}
            <div class="wac-coll__inline">
              {%- for filter in search.filters -%}
                {%- liquid
                  assign n = filter.active_values.size
                  if filter.type == 'price_range'
                    if filter.min_value.value != blank or filter.max_value.value != blank
                      assign n = 1
                    endif
                  endif
                -%}
                <div class="wac-dd" data-wac-dd>
                  <button type="button" class="wac-coll__pill wac-dd__trigger" aria-expanded="false" data-wac-dd-trigger>
                    <span>{{ filter.label | escape }}</span>
                    {%- if n > 0 -%}<span class="wac-coll__count">{{ n }}</span>{%- endif -%}
                    <span class="wac-dd__chev">{{ chevron }}</span>
                  </button>
                  <div class="wac-dd__panel" hidden data-wac-dd-panel>{%- render 'wacoal-filter-values', filter: filter -%}</div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <label class="wac-coll__pill wac-coll__sort">
          <span class="wac-coll__sort-label">Sort:</span>
          <select name="sort_by" class="wac-coll__select" data-wac-sort>
            {%- for option in search.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
          <span class="wac-coll__sort-arrow">{{ chevron }}</span>
        </label>
      </form>

      {%- if active_count > 0 -%}
        <div class="wac-coll__chips">
          {%- for filter in search.filters -%}
            {%- for value in filter.active_values -%}
              <a class="wac-coll__chip" href="{{ value.url_to_remove }}">{{ value.label | escape }} <span aria-hidden="true">&times;</span><span class="visually-hidden">Remove</span></a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                <a class="wac-coll__chip" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">&times;</span></a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="wac-coll__chip wac-coll__chip--clear" href="{{ clear_url }}">Clear all</a>
        </div>
      {%- endif -%}

      <div class="wac-coll__grid" data-wac-grid style="--wac-cols: {{ ss.columns }};">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- liquid
              assign eager = false
              if forloop.index <= ss.columns and paginate.current_page == 1
                assign eager = true
              endif
            -%}
            <div class="wac-coll__cell">
              {%- render 'wacoal-product-card', product: item, badge: '', sizes: '(max-width: 749px) 50vw, 25vw', eager: eager -%}
            </div>
          {%- else -%}
            <div class="wac-coll__cell">
              <a class="wac-srch__other" href="{{ item.url }}">
                <span class="wac-srch__other-type">{% if item.object_type == 'article' %}Journal{% else %}Page{% endif %}</span>
                <span class="wac-srch__other-title">{{ item.title | escape }}</span>
                {%- assign excerpt = item.content | strip_html | strip | truncate: 140 -%}
                {%- if excerpt != blank -%}<span class="wac-srch__other-text">{{ excerpt | escape }}</span>{%- endif -%}
                <span class="wac-srch__other-link">Read</span>
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if ss.infinite_scroll and paginate.pages > 1 -%}
        {%- assign shown_to = paginate.current_offset | plus: search.results.size -%}
        <div
          class="wac-coll__more"
          data-wac-more
          data-next="{{ paginate.next.url }}"
          data-section="{{ section.id }}"
          data-total="{{ paginate.items }}"
          data-shown="{{ shown_to }}"
        >
          <p class="wac-coll__more-status" data-wac-more-status aria-live="polite">Showing {{ shown_to }} of {{ paginate.items }}</p>
          <span class="wac-coll__spinner" data-wac-more-spinner hidden aria-hidden="true"></span>
          <button type="button" class="wac-coll__more-btn" data-wac-more-btn hidden>Load more</button>
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="wac-pag" aria-label="Pages">
          {%- if paginate.previous -%}
            <a class="wac-pag__word" href="{{ paginate.previous.url }}">Prev</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- assign num = part.title | plus: 0 -%}
            {%- if part.is_link -%}
              <a class="wac-pag__num" href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif num == paginate.current_page -%}
              <span class="wac-pag__num is-active" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="wac-pag__ellipsis">&hellip;</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a class="wac-pag__word" href="{{ paginate.next.url }}">Next</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}

    <div class="wac-drawer" id="WacDrawer-{{ section.id }}" hidden data-wac-drawer role="dialog" aria-modal="true" aria-label="Filters">
      <div class="wac-drawer__overlay" data-wac-drawer-close></div>
      <form class="wac-drawer__panel" method="get" action="{{ routes.search_url }}" data-wac-drawer-form>
        {{ hidden_query }}
        <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
        <div class="wac-drawer__head">
          <span class="wac-drawer__title">Filters</span>
          <button type="button" class="wac-drawer__close" data-wac-drawer-close aria-label="Close filters">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="wac-drawer__body">
          {%- for filter in search.filters -%}
            <details class="wac-drawer__group"{% if forloop.first %} open{% endif %}>
              <summary class="wac-drawer__group-title">
                <span>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</span>
                <span class="wac-drawer__plus" aria-hidden="true">+</span><span class="wac-drawer__minus" aria-hidden="true">&minus;</span>
              </summary>
              <div class="wac-drawer__group-body">{%- render 'wacoal-filter-values', filter: filter -%}</div>
            </details>
          {%- else -%}
            <p class="wac-drawer__none">No filters for these results.</p>
          {%- endfor -%}
        </div>
        <div class="wac-drawer__controls">
          <a class="wac-drawer__btn wac-drawer__btn--clear" href="{{ clear_url }}">Clear</a>
          <button type="submit" class="wac-drawer__btn wac-drawer__btn--apply">Apply (<span data-wac-apply-count>{{ active_count }}</span>)</button>
        </div>
      </form>
    </div>
  {%- else -%}
    <div class="wac-srch__empty">
      {%- if search.performed -%}
        <p class="wac-srch__empty-title">{{ ss.empty_title | default: 'Nothing matched' | escape }}</p>
        <p class="wac-srch__empty-text">{{ ss.empty_text | escape }}</p>
      {%- endif -%}
    </div>
    {%- assign picks = ss.picks_collection | default: collections['bras'] -%}
    {%- if picks.products.size > 0 -%}
      <div class="wac-srch__picks">
        <h2 class="wac-srch__picks-title">{{ ss.picks_heading | escape }}</h2>
        <div class="wac-coll__grid" style="--wac-cols: {{ ss.columns }};">
          {%- for product in picks.products limit: ss.columns -%}
            <div class="wac-coll__cell">
              {%- render 'wacoal-product-card', product: product, badge: '', sizes: '(max-width: 749px) 50vw, 25vw' -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

<script src="{{ 'wacoal-collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Wacoal search results",
  "tag": "section",
  "class": "wac-section-search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading before a search", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Search box placeholder", "default": "Search bras, panties, sleepwear..." },
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Products per row on desktop", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "inline_filters", "label": "Show each filter as a pill in the bar (desktop)", "default": true },
    { "type": "checkbox", "id": "infinite_scroll", "label": "Load more results automatically while scrolling", "default": true },
    { "type": "text", "id": "empty_title", "label": "No results: title", "default": "Nothing matched" },
    { "type": "text", "id": "empty_text", "label": "No results: text", "default": "Check the spelling, try a broader word, or pick a type above." },
    { "type": "text", "id": "picks_heading", "label": "No results: products heading", "default": "You might like these" },
    { "type": "collection", "id": "picks_collection", "label": "No results: products from" }
  ],
  "presets": [{ "name": "Wacoal search results" }]
}
{% endschema %}
