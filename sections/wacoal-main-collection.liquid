{% comment %}
  Collection grid (Wacoal collection page): pill filter bar with drop-down panels (desktop),
  a left filter drawer with Clear / Apply (all screens), sort, a product grid with an optional
  promo tile, and numbered pages. Filters are the store's own (Search & Discovery app);
  whatever filters the store offers appear here.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
-%}

{%- capture filter_icon -%}
  <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 2h18M0 8h18" stroke="currentColor" stroke-width="1"/><circle cx="5" cy="2" r="1.6" fill="#fff" stroke="currentColor"/><circle cx="13" cy="8" r="1.6" fill="#fff" stroke="currentColor"/></svg>
{%- endcapture -%}
{%- capture chevron -%}
  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcapture -%}



<div class="wac-coll" data-wac-coll id="WacColl-{{ section.id }}">
  {%- paginate collection.products by ss.per_page -%}
    <form class="wac-coll__bar" method="get" action="{{ collection.url }}" data-wac-inline-form>
      <div class="wac-coll__bar-left">
        <button type="button" class="wac-coll__pill wac-coll__pill--filter" data-wac-drawer-open aria-controls="WacDrawer-{{ section.id }}">
          <span>Filter</span>
          {%- if active_count > 0 -%}<span class="wac-coll__count">{{ active_count }}</span>{%- endif -%}
          {{ filter_icon }}
        </button>

        {%- if ss.inline_filters and collection.filters.size > 0 -%}
          <div class="wac-coll__inline">
            {%- for filter in collection.filters -%}
              {%- liquid
                assign n = filter.active_values.size
                if filter.type == 'price_range'
                  if filter.min_value.value != blank or filter.max_value.value != blank
                    assign n = 1
                  endif
                endif
              -%}
              <div class="wac-dd" data-wac-dd>
                <button type="button" class="wac-coll__pill wac-dd__trigger" aria-expanded="false" data-wac-dd-trigger>
                  <span>{{ filter.label | escape }}</span>
                  {%- if n > 0 -%}<span class="wac-coll__count">{{ n }}</span>{%- endif -%}
                  <span class="wac-dd__chev">{{ chevron }}</span>
                </button>
                <div class="wac-dd__panel" hidden data-wac-dd-panel>{%- render 'wacoal-filter-values', filter: filter -%}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <label class="wac-coll__pill wac-coll__sort">
        <span class="wac-coll__sort-label">Sort:</span>
        <select name="sort_by" class="wac-coll__select" data-wac-sort>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
        <span class="wac-coll__sort-arrow">{{ chevron }}</span>
      </label>

    </form>

    {%- if active_count > 0 -%}
      <div class="wac-coll__chips">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a class="wac-coll__chip" href="{{ value.url_to_remove }}">{{ value.label | escape }} <span aria-hidden="true">&times;</span><span class="visually-hidden">Remove</span></a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
              <a class="wac-coll__chip" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">&times;</span></a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="wac-coll__chip wac-coll__chip--clear" href="{{ clear_url }}">Clear all</a>
      </div>
    {%- endif -%}

    {%- liquid
      assign show_tile = false
      if ss.tile_enabled and paginate.current_page == 1 and collection.products_count > ss.tile_min_products
        assign show_tile = true
      endif
      assign tile_bg = ss.tile_bg
      if ss.tile_gradient != blank
        assign tile_bg = ss.tile_gradient
      endif
    -%}
    <div
      class="wac-coll__grid"
      data-wac-grid
      style="--wac-cols: {{ ss.columns }}; --wac-tile-row: {{ ss.tile_row }}; --wac-tile-row-m: {{ ss.tile_row_mobile }};"
    >
      {%- if show_tile -%}
        <a class="wac-coll__tile wac-coll__tile--{{ ss.tile_side }}" href="{{ ss.tile_link | default: '#' }}" style="--wac-tile-bg: {{ tile_bg }};">
          {%- if ss.tile_image != blank -%}
            <img class="wac-coll__tile-img" src="{{ ss.tile_image | image_url: width: 1400 }}" alt="" loading="lazy" width="{{ ss.tile_image.width }}" height="{{ ss.tile_image.height }}">
          {%- endif -%}
          <span class="wac-coll__tile-content">
            {%- if ss.tile_heading_1 != blank -%}<span class="wac-coll__tile-h1">{{ ss.tile_heading_1 | escape }}</span>{%- endif -%}
            {%- if ss.tile_heading_2 != blank -%}<span class="wac-coll__tile-h2">{{ ss.tile_heading_2 | escape }}</span>{%- endif -%}
            {%- if ss.tile_text != blank -%}<span class="wac-coll__tile-text">{{ ss.tile_text | escape }}</span>{%- endif -%}
            {%- if ss.tile_button != blank -%}<span class="wac-coll__tile-btn">{{ ss.tile_button | escape }}</span>{%- endif -%}
          </span>
        </a>
      {%- endif -%}

      {%- for product in collection.products -%}
        {%- liquid
          assign eager = false
          if forloop.index <= ss.columns and paginate.current_page == 1
            assign eager = true
          endif
        -%}
        <div class="wac-coll__cell">
          {%- render 'wacoal-product-card', product: product, badge: '', sizes: '(max-width: 749px) 50vw, 25vw', eager: eager, new_days: ss.new_days, no_size_flag: ss.hide_size_flag -%}
        </div>
      {%- else -%}
        <div class="wac-coll__empty">
          <p>No products match these filters.</p>
          {%- if active_count > 0 -%}<a class="wac-coll__pill" href="{{ clear_url }}">Clear filters</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if ss.infinite_scroll and paginate.pages > 1 -%}
      {%- liquid
        assign shown_to = paginate.current_offset | plus: collection.products.size
      -%}
      <div
        class="wac-coll__more"
        data-wac-more
        data-next="{{ paginate.next.url }}"
        data-section="{{ section.id }}"
        data-total="{{ paginate.items }}"
        data-shown="{{ shown_to }}"
      >
        <p class="wac-coll__more-status" data-wac-more-status aria-live="polite">Showing {{ shown_to }} of {{ paginate.items }}</p>
        <span class="wac-coll__spinner" data-wac-more-spinner hidden aria-hidden="true"></span>
        <button type="button" class="wac-coll__more-btn" data-wac-more-btn hidden>Load more</button>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="wac-pag" aria-label="Pages">
        {%- if paginate.previous -%}
          <a class="wac-pag__word" href="{{ paginate.previous.url }}">Prev</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- assign num = part.title | plus: 0 -%}
          {%- if part.is_link -%}
            <a class="wac-pag__num" href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif num == paginate.current_page -%}
            <span class="wac-pag__num is-active" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="wac-pag__ellipsis">&hellip;</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a class="wac-pag__word" href="{{ paginate.next.url }}">Next</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}

  {%- if ss.show_full_description and collection.description != blank -%}
    <div class="wac-coll__about rte" id="CollectionAbout">{{ collection.description }}</div>
  {%- endif -%}

  <div class="wac-drawer" id="WacDrawer-{{ section.id }}" hidden data-wac-drawer role="dialog" aria-modal="true" aria-label="Filters">
    <div class="wac-drawer__overlay" data-wac-drawer-close></div>
    <form class="wac-drawer__panel" method="get" action="{{ collection.url }}" data-wac-drawer-form>
      <input type="hidden" name="sort_by" value="{{ sort_by | escape }}">
      <div class="wac-drawer__head">
        <span class="wac-drawer__title">Filters</span>
        <button type="button" class="wac-drawer__close" data-wac-drawer-close aria-label="Close filters">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="wac-drawer__body">
        {%- for filter in collection.filters -%}
          <details class="wac-drawer__group"{% if forloop.first %} open{% endif %}>
            <summary class="wac-drawer__group-title">
              <span>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</span>
              <span class="wac-drawer__plus" aria-hidden="true">+</span><span class="wac-drawer__minus" aria-hidden="true">&minus;</span>
            </summary>
            <div class="wac-drawer__group-body">{%- render 'wacoal-filter-values', filter: filter -%}</div>
          </details>
        {%- else -%}
          <p class="wac-drawer__none">No filters are set up for this store yet.</p>
        {%- endfor -%}
      </div>
      <div class="wac-drawer__controls">
        <a class="wac-drawer__btn wac-drawer__btn--clear" href="{{ clear_url }}">Clear</a>
        <button type="submit" class="wac-drawer__btn wac-drawer__btn--apply">Apply (<span data-wac-apply-count>{{ active_count }}</span>)</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    // leave empty price boxes out of the address
    function cleanSubmit(form) {
      form.querySelectorAll('input[type="number"]').forEach(function (i) { i.disabled = i.value === ''; });
      form.submit();
    }
    function init(root) {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      var inline = root.querySelector('[data-wac-inline-form]');
      var drawer = root.querySelector('[data-wac-drawer]');
      var dform = root.querySelector('[data-wac-drawer-form]');

      // inline drop-downs: open one at a time, apply on change
      var dds = Array.prototype.slice.call(root.querySelectorAll('[data-wac-dd]'));
      function closeAll(except) {
        dds.forEach(function (d) {
          if (d === except) return;
          var p = d.querySelector('[data-wac-dd-panel]'); var t = d.querySelector('[data-wac-dd-trigger]');
          p.hidden = true; t.setAttribute('aria-expanded', 'false'); d.classList.remove('is-open');
        });
      }
      dds.forEach(function (d) {
        var t = d.querySelector('[data-wac-dd-trigger]'); var p = d.querySelector('[data-wac-dd-panel]');
        t.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = p.hidden;
          closeAll(d);
          p.hidden = !open; t.setAttribute('aria-expanded', open ? 'true' : 'false'); d.classList.toggle('is-open', open);
        });
        p.addEventListener('click', function (e) { e.stopPropagation(); });
      });
      document.addEventListener('click', function () { closeAll(null); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeAll(null); closeDrawer(); } });
      if (inline) {
        inline.addEventListener('change', function (e) {
          if (e.target.matches('input[type="checkbox"], select')) cleanSubmit(inline);
        });
        inline.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' && e.target.matches('input[type="number"]')) { e.preventDefault(); cleanSubmit(inline); }
        });
        inline.querySelectorAll('input[type="number"]').forEach(function (i) { i.addEventListener('change', function () { cleanSubmit(inline); }); });
      }

      // drawer
      var opener = null;
      function openDrawer() {
        opener = document.activeElement;
        drawer.hidden = false;
        document.documentElement.classList.add('wac-drawer-open');
        requestAnimationFrame(function () { drawer.classList.add('is-open'); });
        var c = drawer.querySelector('.wac-drawer__close'); if (c) c.focus();
      }
      function closeDrawer() {
        if (!drawer || drawer.hidden) return;
        drawer.classList.remove('is-open');
        document.documentElement.classList.remove('wac-drawer-open');
        setTimeout(function () { drawer.hidden = true; }, 250);
        if (opener && opener.focus) opener.focus();
      }
      root.querySelectorAll('[data-wac-drawer-open]').forEach(function (b) { b.addEventListener('click', function (e) { e.stopPropagation(); closeAll(null); openDrawer(); }); });
      if (drawer) drawer.querySelectorAll('[data-wac-drawer-close]').forEach(function (b) { b.addEventListener('click', closeDrawer); });
      if (dform) {
        dform.addEventListener('submit', function (e) { e.preventDefault(); cleanSubmit(dform); });
        var countEl = dform.querySelector('[data-wac-apply-count]');
        dform.addEventListener('change', function () {
          var n = dform.querySelectorAll('input[type="checkbox"]:checked').length;
          dform.querySelectorAll('input[type="number"]').forEach(function (i) { if (i.value !== '') n += 0.5; });
          if (countEl) countEl.textContent = Math.ceil(n);
        });
      }
    }
    // infinite load: append the next page's cards when the end of the grid comes near
    function initMore(root) {
      var more = root.querySelector('[data-wac-more]');
      var grid = root.querySelector('[data-wac-grid]');
      if (!more || !grid || !more.dataset.next) return;
      root.classList.add('wac-coll--infinite');
      var status = more.querySelector('[data-wac-more-status]');
      var spinner = more.querySelector('[data-wac-more-spinner]');
      var btn = more.querySelector('[data-wac-more-btn]');
      var busy = false;
      function done() {
        observer.disconnect();
        spinner.hidden = true; btn.hidden = true;
        status.textContent = 'You have seen all ' + more.dataset.total + ' products';
      }
      function load() {
        var next = more.dataset.next;
        if (busy || !next) return;
        if (document.documentElement.dataset.wacNoAutoload) return;
        busy = true; spinner.hidden = false; btn.hidden = true;
        var url = next + (next.indexOf('?') > -1 ? '&' : '?') + 'section_id=' + encodeURIComponent(more.dataset.section);
        fetch(url, { credentials: 'same-origin' })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var cells = doc.querySelectorAll('[data-wac-grid] > .wac-coll__cell');
            cells.forEach(function (c) { grid.appendChild(document.importNode(c, true)); });
            var nextMore = doc.querySelector('[data-wac-more]');
            more.dataset.next = nextMore ? nextMore.dataset.next : '';
            more.dataset.shown = nextMore ? nextMore.dataset.shown : more.dataset.total;
            status.textContent = 'Showing ' + more.dataset.shown + ' of ' + more.dataset.total;
            busy = false; spinner.hidden = true;
            if (!more.dataset.next) { done(); return; }
            // still near the end (tall screens): keep going
            var rect = more.getBoundingClientRect();
            if (rect.top < window.innerHeight + 800) load();
          })
          .catch(function () {
            busy = false; spinner.hidden = true; btn.hidden = false;
          });
      }
      var observer = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) load();
      }, { rootMargin: '0px 0px 800px 0px' });
      observer.observe(more);
      btn.addEventListener('click', function () { delete document.documentElement.dataset.wacNoAutoload; load(); });
    }

    function all() {
      document.querySelectorAll('[data-wac-coll]').forEach(function (root) {
        var fresh = !root.dataset.ready;
        init(root);
        if (fresh) initMore(root);
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
    document.addEventListener('shopify:section:load', all);
  })();
</script>

{% schema %}
{
  "name": "Wacoal collection grid",
  "tag": "div",
  "class": "wac-section-coll",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "infinite_scroll", "label": "Load more products automatically while scrolling", "default": true, "info": "Page numbers stay for search engines and when this is off." },
    { "type": "range", "id": "columns", "label": "Products per row on desktop", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "inline_filters", "label": "Show each filter as a pill in the bar (desktop)", "default": true },
    { "type": "checkbox", "id": "show_full_description", "label": "Show the full collection description under the products", "default": true },
    { "type": "range", "id": "new_days", "label": "\"New arrival\" label for products published in the last (days)", "min": 0, "max": 90, "step": 1, "default": 30, "info": "0 turns it off. Products tagged New always get it." },
    { "type": "checkbox", "id": "hide_size_flag", "label": "Hide the size range label (S-XL / Up to E cup)", "default": false },
    { "type": "header", "content": "Promo tile in the grid" },
    { "type": "checkbox", "id": "tile_enabled", "label": "Show the promo tile", "default": true, "info": "Two columns wide, first page only." },
    { "type": "range", "id": "tile_row", "label": "Row on desktop", "min": 1, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "tile_row_mobile", "label": "Row on phones", "min": 1, "max": 8, "step": 1, "default": 3 },
    { "type": "select", "id": "tile_side", "label": "Side on desktop", "options": [ { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" } ], "default": "right" },
    { "type": "range", "id": "tile_min_products", "label": "Hide the tile when a collection has this many products or fewer", "min": 0, "max": 24, "step": 1, "default": 8 },
    { "type": "color", "id": "tile_bg", "label": "Tile background", "default": "#cdc9de" },
    { "type": "color_background", "id": "tile_gradient", "label": "Tile gradient", "info": "Optional. Used instead of the background colour." },
    { "type": "image_picker", "id": "tile_image", "label": "Tile image", "info": "Optional. Fills the tile behind the text." },
    { "type": "text", "id": "tile_heading_1", "label": "Small heading", "default": "all sale panties" },
    { "type": "text", "id": "tile_heading_2", "label": "Large heading", "default": "BUY 3 GET 3 FREE" },
    { "type": "text", "id": "tile_text", "label": "Text", "default": "limited time only" },
    { "type": "text", "id": "tile_button", "label": "Button label", "default": "SHOP NOW" },
    { "type": "url", "id": "tile_link", "label": "Tile link" }
  ],
  "presets": [ { "name": "Wacoal collection grid" } ]
}
{% endschema %}
