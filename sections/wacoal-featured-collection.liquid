{% comment %}
  "Best Sellers" product carousel (Wacoal featured collection): centred serif heading
  and sub-heading, round prev/next buttons at the right, a horizontally scrolling row of
  product cards: image (second image on hover), badge pills, colour swatches, vendor and
  style number, title, price, star rating. Products come from the chosen collection.
{% endcomment %}
{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.max_products
-%}
<div class="wac-featured" data-wac-featured>
  <div class="wac-featured__container">
    <div class="wac-featured__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="wac-featured__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="wac-featured__sub"><p>{{ section.settings.subheading | escape }}</p></div>
      {%- endif -%}
    </div>

    <div class="wac-featured__body">
      <div class="wac-featured__nav">
        <button type="button" class="wac-featured__arrow wac-featured__arrow--prev is-disabled" data-wac-featured-prev aria-label="Previous products" disabled>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="wac-featured__arrow wac-featured__arrow--next" data-wac-featured-next aria-label="Next products">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="wac-featured__track" data-wac-featured-track>
        {%- for product in collection.products limit: limit -%}
          {%- render 'wacoal-product-card', product: product, badge: section.settings.badge, sizes: '278px' -%}
        {%- else -%}
          <p class="wac-featured__empty">Choose a collection with products.</p>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function init(root) {
      if (root.dataset.wacFeaturedReady) return;
      root.dataset.wacFeaturedReady = '1';
      var track = root.querySelector('[data-wac-featured-track]');
      var prev = root.querySelector('[data-wac-featured-prev]');
      var next = root.querySelector('[data-wac-featured-next]');
      if (!track || !prev || !next) return;
      function step() {
        var card = track.querySelector('.wac-card');
        if (!card) return track.clientWidth;
        var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0) || 0;
        var w = card.getBoundingClientRect().width + gap;
        var n = Math.max(1, Math.floor((track.clientWidth + gap) / w));
        return n * w;
      }
      function update() {
        var max = track.scrollWidth - track.clientWidth - 1;
        var atStart = track.scrollLeft <= 1;
        var atEnd = track.scrollLeft >= max;
        prev.classList.toggle('is-disabled', atStart); prev.disabled = atStart;
        next.classList.toggle('is-disabled', atEnd); next.disabled = atEnd;
      }
      prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
    function initAll() { document.querySelectorAll('[data-wac-featured]').forEach(init); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll); else initAll();
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% schema %}
{
  "name": "BLS best sellers",
  "tag": "section",
  "class": "wac-section-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "text", "id": "subheading", "label": "Sub-heading", "default": "Crafted for consistency, chosen for comfort — these are the styles that set the standard." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "max_products", "label": "Products", "min": 4, "max": 20, "step": 1, "default": 10 },
    { "type": "text", "id": "badge", "label": "Badge on every card", "default": "Best Seller", "info": "Leave empty for no badge. Sale items also get a Sale pill." }
  ],
  "presets": [ { "name": "BLS best sellers" } ]
}
{% endschema %}
