{% comment %}
  Row of image tiles with text at the bottom (Wacoal "two-up featured collections",
  here with any number of columns). Each tile: image, two heading lines (second in
  italics), a line of text and a pill button; the whole tile links.
  Images: picked from Files, or a file name in assets/ while placeholders are used.
{% endcomment %}
{%- liquid
  assign cols = section.settings.columns
  if section.blocks.size < cols
    assign cols = section.blocks.size
  endif
-%}
<div
  class="wac-tiles wac-tiles--mobile-{{ section.settings.mobile_layout }}"
  style="--wac-tiles-cols: {{ cols }}; --wac-tile-h: {{ section.settings.tile_height }}px; --wac-tile-h-mobile: {{ section.settings.tile_height_mobile }}px; --wac-tiles-gap: {{ section.settings.gap }}px;"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign src = ''
      assign srcset = ''
      if block.settings.image != blank
        assign src = block.settings.image | image_url: width: 1440
        assign srcset = block.settings.image | image_url: width: 720 | append: ' 720w, ' | append: src | append: ' 1440w'
      elsif block.settings.image_asset != blank
        assign src = block.settings.image_asset | asset_url
      endif
      assign src_mobile = ''
      if block.settings.image_mobile != blank
        assign src_mobile = block.settings.image_mobile | image_url: width: 800
      elsif block.settings.image_mobile_asset != blank
        assign src_mobile = block.settings.image_mobile_asset | asset_url
      endif
      assign button_link = block.settings.button_link | default: block.settings.link
    -%}
    <div class="wac-tile" {{ block.shopify_attributes }}>
      {%- if src != blank -%}
        <picture class="wac-tile__picture">
          {%- if src_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ src_mobile }}">
          {%- endif -%}
          <img
            class="wac-tile__img"
            src="{{ src }}"
            {% if srcset != blank %}srcset="{{ srcset }}" sizes="(max-width: 749px) 100vw, {{ 100 | divided_by: cols }}vw"{% endif %}
            alt="{{ block.settings.image.alt | default: block.settings.heading_line1 | escape }}"
            loading="lazy"
          >
        </picture>
      {%- endif -%}
      {%- if block.settings.link != blank -%}
        <a class="wac-tile__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.button_label | default: block.settings.heading_line1 | escape }}"></a>
      {%- endif -%}
      <div class="wac-tile__content">
        {%- if block.settings.heading_line1 != blank or block.settings.heading_line2 != blank -%}
          <h2 class="wac-tile__heading">
            {{- block.settings.heading_line1 | escape -}}
            {%- if block.settings.heading_line2 != blank -%}
              <br><em>{{ block.settings.heading_line2 | escape }}</em>
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="wac-tile__text"><p>{{ block.settings.text | escape }}</p></div>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <div class="wac-tile__buttons">
            <a class="wac-tile__button" href="{{ button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Wacoal tiles",
  "tag": "section",
  "class": "wac-section-tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "columns", "label": "Tiles per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "tile_height", "label": "Tile height on desktop (px)", "min": 300, "max": 800, "step": 10, "default": 540 },
    { "type": "range", "id": "tile_height_mobile", "label": "Tile height on phones (px)", "min": 200, "max": 700, "step": 10, "default": 400 },
    { "type": "select", "id": "mobile_layout", "label": "Phone layout", "options": [ { "value": "stack", "label": "One per row" }, { "value": "two", "label": "Two per row" } ], "default": "stack" },
    { "type": "range", "id": "gap", "label": "Gap between tiles (px)", "min": 0, "max": 40, "step": 2, "default": 0 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "or asset file name", "info": "Used only while no image is picked, e.g. wacoal-tile-1.jpg" },
        { "type": "image_picker", "id": "image_mobile", "label": "Image (phone)" },
        { "type": "text", "id": "image_mobile_asset", "label": "or asset file name (phone)" },
        { "type": "text", "id": "heading_line1", "label": "Heading, first line", "default": "A New Standard for" },
        { "type": "text", "id": "heading_line2", "label": "Heading, second line (italic)", "default": "Smaller Bustlines" },
        { "type": "text", "id": "text", "label": "Text", "default": "Available in 30–38 bands and A–DDD cups" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP NOW" },
        { "type": "url", "id": "link", "label": "Tile link" },
        { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to use the tile link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wacoal tiles",
      "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ]
    }
  ]
}
{% endschema %}
