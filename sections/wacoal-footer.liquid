{% comment %}
  Footer (Wacoal "Footer--dark"): black band with menu columns (accordions on phones),
  a newsletter sign-up column with social icons, and a grey info bar with the
  copyright and policy links. Columns are blocks: "menu" (a navigation menu) or
  "links" (up to five hand-typed links).
{% endcomment %}
{%- liquid
  assign year = 'now' | date: '%Y'
-%}
<footer class="wac-footer">
  <div class="wac-footer__wrap">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' or 'links' -%}
          <details class="wac-footer__block wac-footer__block--menu" {{ block.shopify_attributes }}>
            <summary class="wac-footer__header">
              <h3 class="wac-footer__heading">{{ block.settings.heading | escape }}</h3>
              <span class="wac-footer__toggle" aria-hidden="true"><span class="wac-footer__plus">+</span><span class="wac-footer__minus">&minus;</span></span>
            </summary>
            <div class="wac-footer__content">
              <ul class="wac-footer__menu" role="list">
                {%- if block.type == 'menu' -%}
                  {%- for link in block.settings.menu.links -%}
                    <li class="wac-footer__item"><a class="wac-footer__link" href="{{ link.url }}">{{ link.title | strip | escape }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..5) -%}
                    {%- liquid
                      assign label_key = 'label_' | append: i
                      assign url_key = 'url_' | append: i
                      assign label = block.settings[label_key]
                      assign url = block.settings[url_key]
                    -%}
                    {%- if label != blank -%}
                      <li class="wac-footer__item"><a class="wac-footer__link" href="{{ url | default: '#' }}">{{ label | escape }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          </details>
        {%- when 'signup' -%}
          <div class="wac-footer__block wac-footer__block--signup" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="wac-footer__heading wac-footer__heading--signup">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            <div class="wac-footer__signup">
              {%- form 'customer', class: 'wac-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="wac-footer__form-msg">{{ 'content.newsletter_success' | t | default: 'Thanks for subscribing.' }}</p>
                {%- else -%}
                  <label class="visually-hidden" for="wac-footer-email-{{ section.id }}">Email address</label>
                  <input
                    id="wac-footer-email-{{ section.id }}"
                    class="wac-footer__input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ block.settings.placeholder | default: 'Email Address' | escape }}"
                    autocomplete="email"
                    required
                  >
                  {%- if form.errors -%}
                    <p class="wac-footer__form-msg wac-footer__form-msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                  {%- endif -%}
                  {%- if block.settings.consent != blank -%}
                    <p class="wac-footer__consent">{{ block.settings.consent }}</p>
                  {%- endif -%}
                  <button type="submit" class="wac-footer__submit">{{ block.settings.button_label | default: 'Subscribe' | escape }}</button>
                {%- endif -%}
              {%- endform -%}
            </div>
            {%- if block.settings.note_heading != blank or block.settings.note != blank -%}
              <div class="wac-footer__note">
                {%- if block.settings.note_heading != blank -%}<p class="wac-footer__note-heading">{{ block.settings.note_heading }}</p>{%- endif -%}
                {%- if block.settings.note != blank -%}<div class="wac-footer__note-text">{{ block.settings.note }}</div>{%- endif -%}
              </div>
            {%- endif -%}
            {%- assign socials = '' -%}
            {%- if block.settings.instagram != blank or block.settings.facebook != blank or block.settings.tiktok != blank or block.settings.youtube != blank or block.settings.pinterest != blank or block.settings.whatsapp != blank -%}
              <ul class="wac-footer__social" role="list" aria-label="Follow us">
                {%- if block.settings.instagram != blank -%}
                  <li><a class="wac-footer__social-link" href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2M12 0C8.7 0 8.3 0 7.1.1 5.8.1 4.9.3 4.1.6c-.8.3-1.5.7-2.1 1.4C1.3 2.6.9 3.3.6 4.1.3 4.9.1 5.8.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.1 1.3.3 2.2.6 2.9.3.8.7 1.5 1.4 2.1.6.7 1.3 1.1 2.1 1.4.8.3 1.6.5 2.9.6 1.2.1 1.6.1 4.9.1s3.7 0 4.9-.1c1.3-.1 2.2-.3 2.9-.6.8-.3 1.5-.7 2.1-1.4.7-.6 1.1-1.3 1.4-2.1.3-.8.5-1.6.6-2.9.1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.1-1.3-.3-2.2-.6-2.9-.3-.8-.7-1.5-1.4-2.1-.6-.7-1.3-1.1-2.1-1.4-.8-.3-1.6-.5-2.9-.6C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z"/></svg></a></li>
                {%- endif -%}
                {%- if block.settings.facebook != blank -%}
                  <li><a class="wac-footer__social-link" href="{{ block.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.3l-.5 3.5h-2.8v8.4A12 12 0 0 0 24 12z"/></svg></a></li>
                {%- endif -%}
                {%- if block.settings.tiktok != blank -%}
                  <li><a class="wac-footer__social-link" href="{{ block.settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 5.3a5 5 0 0 1-3-3H13v13.7a3 3 0 1 1-2-2.8V9.9a6.1 6.1 0 1 0 5.1 6V8.6a8 8 0 0 0 4.9 1.6V7a5 5 0 0 1-1.4-1.7z"/></svg></a></li>
                {%- endif -%}
                {%- if block.settings.youtube != blank -%}
                  <li><a class="wac-footer__social-link" href="{{ block.settings.youtube }}" target="_blank" rel="noopener" aria-label="YouTube"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></a></li>
                {%- endif -%}
                {%- if block.settings.pinterest != blank -%}
                  <li><a class="wac-footer__social-link" href="{{ block.settings.pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0a12 12 0 0 0-4.4 23.2c-.1-.9-.2-2.4 0-3.4l1.4-6s-.4-.7-.4-1.8c0-1.7 1-2.9 2.2-2.9 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.1 0 3.8-2.2 3.8-5.5 0-2.9-2.1-4.9-5-4.9-3.4 0-5.4 2.6-5.4 5.2 0 1 .4 2.1.9 2.7.1.1.1.2.1.4l-.3 1.4c-.1.2-.2.3-.4.2-1.5-.7-2.4-2.9-2.4-4.6 0-3.8 2.7-7.2 7.9-7.2 4.1 0 7.4 3 7.4 6.9 0 4.1-2.6 7.4-6.2 7.4-1.2 0-2.4-.6-2.8-1.4l-.7 2.8c-.3 1-1 2.3-1.5 3.1A12 12 0 1 0 12 0z"/></svg></a></li>
                {%- endif -%}
                {%- if block.settings.whatsapp != blank -%}
                  <li><a class="wac-footer__social-link" href="{{ block.settings.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12 0C5.5 0 .2 5.3.2 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.3-1.7a11.9 11.9 0 0 0 5.7 1.5c6.5 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.4zM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.8 9.8 0 0 1-1.5-5.3C2.2 6.4 6.6 2 12 2c2.6 0 5.1 1 6.9 2.9a9.7 9.7 0 0 1 2.9 6.9c0 5.5-4.4 9.9-9.8 10zm5.4-7.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/></svg></a></li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="wac-footer__info">
    <div class="wac-footer__info-wrap">
      <p class="wac-footer__copyright">
        &copy; {{ year }} {{ shop.name | escape }}. All Rights Reserved
        {%- for policy in shop.policies -%}
          {%- if policy.body != blank -%}
            <span class="wac-footer__sep" aria-hidden="true">|</span><a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Wacoal footer",
  "tag": "div",
  "class": "wac-section-footer",
  "max_blocks": 6,
  "settings": [],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
      ]
    },
    {
      "type": "links",
      "name": "Links column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Support" },
        { "type": "text", "id": "label_1", "label": "Link 1 label" },
        { "type": "url", "id": "url_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Link 2 label" },
        { "type": "url", "id": "url_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Link 3 label" },
        { "type": "url", "id": "url_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Link 4 label" },
        { "type": "url", "id": "url_4", "label": "Link 4" },
        { "type": "text", "id": "label_5", "label": "Link 5 label" },
        { "type": "url", "id": "url_5", "label": "Link 5" }
      ]
    },
    {
      "type": "signup",
      "name": "Sign-up column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sign up for 10% off your first order!*" },
        { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Email Address" },
        { "type": "richtext", "id": "consent", "label": "Text under the field", "default": "<p>By submitting your email, you agree to receive marketing messages from British Lingerie Studio.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
        { "type": "inline_richtext", "id": "note_heading", "label": "Note heading" },
        { "type": "richtext", "id": "note", "label": "Note text" },
        { "type": "url", "id": "instagram", "label": "Instagram" },
        { "type": "url", "id": "facebook", "label": "Facebook" },
        { "type": "url", "id": "tiktok", "label": "TikTok" },
        { "type": "url", "id": "youtube", "label": "YouTube" },
        { "type": "url", "id": "pinterest", "label": "Pinterest" },
        { "type": "url", "id": "whatsapp", "label": "WhatsApp" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [
    {
      "name": "Wacoal footer",
      "blocks": [ { "type": "menu" }, { "type": "links" }, { "type": "signup" } ]
    }
  ]
}
{% endschema %}
